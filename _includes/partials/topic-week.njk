<style>
  .tw{border-top:2px solid var(--green);margin-top:14px;padding:13px 0 6px}
  .tw-head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:4px}
  .tw-k{font-family:var(--mono);font-size:var(--fs-label);letter-spacing:.06em;text-transform:uppercase;color:var(--green-d);font-weight:600}
  .tw-head h2{font-size:var(--fs-h2);line-height:1.2;margin:4px 0 0}
  .tw-note{font-family:var(--mono);font-size:var(--fs-label);line-height:1.45;color:var(--mut);text-align:right;max-width:44ch}
  .tw-summary{font-size:var(--fs-small);line-height:1.6;color:var(--ink-2);max-width:74ch;margin:10px 0 2px;padding-left:14px;border-left:2px solid var(--green)}
  .tw-list{list-style:none;margin:10px 0 0;padding:0}
  .tw-item{border-top:1px solid var(--line);padding:13px 0}
  .tw-item:first-child{border-top:0}
  .tw-item[hidden]{display:none}
  .tw-meta{font-family:var(--mono);font-size:var(--fs-label);letter-spacing:.04em;text-transform:uppercase;color:var(--mut)}
  .tw-title{display:inline-block;font-size:var(--fs-h3);line-height:1.35;color:var(--ink);text-decoration:none;margin-top:4px;max-width:72ch}
  .tw-title:hover{text-decoration:underline;text-decoration-color:var(--green);text-underline-offset:4px}
  .tw-dek{font-size:var(--fs-meta);line-height:1.5;color:var(--ink-2);max-width:76ch;margin:5px 0 0}
  .tw-quiet{font-size:var(--fs-meta);line-height:1.5;color:var(--mut);border-top:1px solid var(--line);padding:12px 0;margin:10px 0 0;max-width:76ch}
  .tw-more{background:none;border:0;padding:11px 0 4px;color:var(--green-d);font-family:var(--mono);font-size:var(--fs-label);font-weight:650;letter-spacing:.035em;text-transform:uppercase;cursor:pointer}
  .tw-more:hover{color:var(--green)}
  .tw-more[hidden]{display:none}
  .tw-thread{border:1px solid var(--line-2);border-left:3px solid var(--green);border-radius:4px;background:var(--paper-2);padding:14px 16px;margin:16px 0 8px}
  .tw-thread-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
  .tw-thread-head b{font-size:var(--fs-small)}
  .tw-thread-note{font-family:var(--mono);font-size:var(--fs-label);color:var(--mut)}
  .tw-thread ul{list-style:none;margin:9px 0 0;padding:0}
  .tw-thread li{padding:6px 0;border-top:1px solid var(--line)}
  .tw-thread li:first-child{border-top:0}
  .tw-thread a{color:var(--ink);text-decoration:none;font-size:var(--fs-meta);line-height:1.45}
  .tw-thread a:hover{text-decoration:underline;text-decoration-color:var(--green)}
  .tw-thread .tw-meta{display:inline;margin-left:8px;text-transform:none;letter-spacing:0}
  @media(max-width:620px){.tw-head{flex-direction:column;align-items:start;gap:5px}.tw-note{text-align:left}}
</style>
{% set room = weeklyTop.rooms[weekKey] %}
{% set week = room.items %}
{% set showChina = weekKey == 'usmexico' and weeklyTop.china.length %}
{% if (week and week.length) or showChina %}
<section class="tw" aria-labelledby="tw-title">
  <div class="tw-head">
    <div><div class="tw-k">This week</div><h2 id="tw-title">The last 7 days</h2></div>
  </div>
  {% if room.summary %}<p class="tw-summary">{{ room.summary }}</p>{% endif %}
  {% if week and week.length %}
  <ol class="tw-list">
    {% for it in week %}
    <li class="tw-item{% if loop.index > 5 %} tw-extra{% endif %}"{% if loop.index > 5 %} hidden{% endif %}>
      <div class="tw-meta">{{ it.sourceName }} · {{ it.dateLabel }}</div>
      <a class="tw-title" href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a>
      {% if it.dek %}<p class="tw-dek">{{ it.dek }}</p>{% endif %}
    </li>
    {% endfor %}
  </ol>
  {% if week.length > 5 %}<button class="tw-more" type="button" data-tw-more>Show {{ week.length - 5 }} more</button>{% endif %}
  {% else %}
  <p class="tw-quiet">A quiet week in this section: nothing from the named outlets cleared the bar.</p>
  {% endif %}
  {% if showChina %}
  <div class="tw-thread">
    <div class="tw-thread-head"><span class="tw-k">Standing theme</span><b>Mexico–China</b><span class="tw-thread-note">Chinese investment, transshipment and tariffs, tracked continuously</span></div>
    <ul>
      {% for it in weeklyTop.china %}
      <li><a href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a><span class="tw-meta">{{ it.sourceName }} · {{ it.dateLabel }}</span></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</section>
<script>
  document.querySelectorAll('[data-tw-more]').forEach(function(btn){
    btn.addEventListener('click',function(){
      var root=btn.closest('.tw');
      if(root)root.querySelectorAll('.tw-extra').forEach(function(row){row.hidden=false;});
      btn.hidden=true;
    });
  });
</script>
{% endif %}
