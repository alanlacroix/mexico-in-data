{#- The footer, to the design handoff of 2026-08-02: the wordmark in identical markup to
   the masthead, the tagline string verbatim below it, and the same five links the menu
   prints, from _data/footernav.js, so the two lists can never diverge. -#}
<footer class="foot">
  <div class="foot-row">
    <div class="foot-brand">
      <a class="brand" href="/">THE MEXICO <span class="u">BRIEF</span></a>
      <p class="fblurb">{{ footerBlurb or "Mexico’s economic, political, security and business news, all in one place." }}</p>
    </div>
    <nav class="fnav" aria-label="Footer navigation">{% for item in footernav %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</nav>
  </div>
</footer>
