{# Interface: expects `story`, `locale`, and `loop` in the current context. #}
<article class="development{% if loop.first %} development-lead{% endif %}">
  <header class="development-head">
    <div>
      <div class="story-meta"><span>{{ story.cat }}</span><span>{{ story.date }}</span></div>
      <h2>{{ story.title }}</h2>
    </div>
  </header>
  <div class="story-grid">
    <div class="story-block story-change"><p>{{ story.dek }}</p></div>
    <section class="story-block story-impact"><h3>{% if locale == 'es' %}Implicaciones para las empresas{% else %}Business implications{% endif %}</h3><p>{{ story.view }}</p></section>
    {% if story.bg %}<div class="story-block story-context"><p>{{ story.bg }}</p></div>{% endif %}
    {% if story.watch %}<section class="story-block"><h3>{% if locale == 'es' %}Qué sigue{% else %}Next{% endif %}</h3><p>{{ story.watch }}</p></section>{% endif %}
  </div>
  <div class="story-sources">
    <span>{% if locale == 'es' %}Fuentes{% else %}Sources{% endif %}</span>
    <a href="{{ story.url }}" target="_blank" rel="noopener">{{ story.source }} <span aria-hidden="true">↗</span></a>
    {% for source in story.analysisSources %}{% if source.url != story.url %}<a href="{{ source.url }}" target="_blank" rel="noopener">{{ source.source }} <span aria-hidden="true">↗</span></a>{% endif %}{% endfor %}
  </div>
</article>
