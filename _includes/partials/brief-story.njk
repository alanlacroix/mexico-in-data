{# Interface: expects `story`, `locale`, and `loop` in the current context. #}
{% set storyAnchor = story.id or ('story-' + loop.index) %}
{% set sourceList = story.sources or story.analysisSources or [{ source: story.source, url: story.url }] %}
{% macro evidenceLabel(source) %}{% if source.kind == 'official-history' or 'monetary-policy-announcements.html' in source.url %}{{ source.source }} — {% if locale == 'es' %}historial de decisiones{% else %}policy-decision history{% endif %}{% elif source.kind == 'official-statement' or 'announcements-of-monetary-policy-decisions' in source.url %}{{ source.source }} — {% if locale == 'es' %}comunicado de política monetaria{% else %}monetary-policy statement{% endif %}{% elif source.kind == 'official-bulletin' %}{{ source.source }} — {% if locale == 'es' %}boletín estadístico{% else %}statistical bulletin{% endif %}{% elif source.kind == 'article-body' or source.kind == 'article' or source.url == story.url %}{{ source.source }} — {% if locale == 'es' %}artículo{% else %}article{% endif %}{% else %}{{ source.source }}{% endif %}{% endmacro %}
<article class="development{% if story.editorial %} development-annotated{% endif %}{% if loop.first %} development-lead{% endif %}">
  <header class="development-head">
    <div>
      <div class="story-meta"><span>{{ story.cat }}</span><span>{{ story.date }}</span></div>
      <h2>{{ story.title }}</h2>
      {% if story.editorial %}<p class="story-lead-summary">{{ story.dek }}</p>{% endif %}
    </div>
  </header>
  {% if story.editorial %}
  <section class="story-thread" aria-label="{% if locale == 'es' %}La secuencia{% else %}The sequence{% endif %}">
    {% for step in story.editorial.timeline %}<div class="thread-step"><h3>{{ step.label }}</h3><p>{{ step.text }}</p>{% for source in step.sources %}{% set citation = 0 %}{% for listed in sourceList %}{% if listed.url == source.url %}{% set citation = loop.index %}{% endif %}{% endfor %}{% if citation %}<a href="#source-{{ storyAnchor }}-{{ citation }}" class="source-citation" aria-label="{% if locale == 'es' %}Fuente{% else %}Source{% endif %} {{ citation }}: {{ evidenceLabel(source) | striptags | trim }}">{{ citation }}</a>{% endif %}{% endfor %}</div>{% endfor %}
  </section>
  <div class="annotated-body">
  {% endif %}
  <div class="story-grid">
    {% if not story.editorial %}<div class="story-block story-change"><p>{{ story.dek }}</p></div>{% endif %}
    <section class="story-block story-impact"><h3>{% if locale == 'es' %}Nuestra lectura{% else %}Our reading{% endif %}</h3><p>{{ story.view }}</p></section>
    {% if story.bg %}<div class="story-block story-context"><p>{{ story.bg }}</p></div>{% endif %}
    {% if story.watch %}<section class="story-block"><h3>{% if locale == 'es' %}Qué sigue{% else %}Next{% endif %}</h3><p>{{ story.watch }}</p></section>{% endif %}
  </div>
  {% if story.editorial %}<aside class="editor-margin"><h3>{% if locale == 'es' %}Al margen{% else %}In the margin{% endif %}</h3><p>{{ story.editorial.margin }}</p>{% for source in story.editorial.marginSources %}{% set citation = 0 %}{% for listed in sourceList %}{% if listed.url == source.url %}{% set citation = loop.index %}{% endif %}{% endfor %}{% if citation %}<a href="#source-{{ storyAnchor }}-{{ citation }}" class="source-citation" aria-label="{% if locale == 'es' %}Fuente{% else %}Source{% endif %} {{ citation }}: {{ evidenceLabel(source) | striptags | trim }}">{{ citation }}</a>{% endif %}{% endfor %}</aside></div>{% endif %}
  <div class="story-sources" aria-label="{% if locale == 'es' %}Fuentes{% else %}Sources{% endif %}">
    <span>{% if locale == 'es' %}Fuentes{% else %}Sources{% endif %}</span>
    {% for source in sourceList %}<a id="source-{{ storyAnchor }}-{{ loop.index }}" href="{{ source.url }}" target="_blank" rel="noopener"><span class="source-index">[{{ loop.index }}]</span> {{ evidenceLabel(source) | trim }} <span aria-hidden="true">↗</span></a>{% endfor %}
  </div>
</article>
