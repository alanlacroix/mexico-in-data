{#- The homepage is the product. Its masthead needs only the name, the promise and the
    reader-controlled language switch. There is no menu because there are no secondary
    product pages to advertise. -#}
<header class="mast">
  <div class="mast-row">
    <a class="brand" href="{{ '/es/' if locale == 'es' else '/' }}">THE MEXICO <span class="u">BRIEF</span></a>
    {%- set Lh = uiStrings[locale] if locale else uiStrings.en %}
    <span class="mast-tag">{% if locale == 'es' %}Una selección semanal de noticias empresariales de México, basada en información publicada en inglés y español.{% else %}A weekly selection of Mexico’s business news, drawn from reporting in English and Spanish.{% endif %}</span>
    {#- Do not advertise an older Spanish snapshot as the translation of a newer Brief. -#}
    {%- if alternateUrl %}<a class="lang-link" href="{{ alternateUrl }}" lang="{{ 'en' if locale == 'es' else 'es' }}" hreflang="{{ 'en' if locale == 'es' else 'es' }}">{{ 'English' if locale == 'es' else 'Español' }}</a>
    {%- elif page.url == '/' and not feedEs.translationCarrying %}<a class="lang-link" href="/es/" lang="es" hreflang="es">Español</a>
    {%- elif page.url == '/es/' %}<a class="lang-link" href="/" lang="en" hreflang="en">English</a>{% endif %}
  </div>
</header>
