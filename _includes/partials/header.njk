{#- The homepage is the product. Its masthead needs only the name, the promise and the
    reader-controlled language switch. There is no menu because there are no secondary
    product pages to advertise. -#}
<header class="mast">
  <div class="mast-row">
    <a class="brand" href="{{ '/es/' if locale == 'es' else '/' }}">THE MEXICO <span class="u">BRIEF</span></a>
    {%- set Lh = uiStrings[locale] if locale else uiStrings.en %}
    <span class="mast-tag">{% if locale == 'es' %}La información empresarial que importa en México. Conectada y explicada.{% else %}The business news that matters in Mexico. Connected and explained.{% endif %}</span>
    {#- Do not advertise an older Spanish snapshot as the translation of a newer Brief. -#}
    {%- if alternateUrl %}<a class="lang-link" href="{{ alternateUrl }}" lang="{{ 'en' if locale == 'es' else 'es' }}" hreflang="{{ 'en' if locale == 'es' else 'es' }}">{{ 'EN' if locale == 'es' else 'ES' }}</a>
    {%- elif page.url == '/' and not feedEs.translationCarrying %}<a class="lang-link" href="/es/" lang="es" hreflang="es">ES</a>
    {%- elif page.url == '/es/' %}<a class="lang-link" href="/" lang="en" hreflang="en">EN</a>{% endif %}
  </div>
</header>
