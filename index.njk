---
layout: base.njk
permalink: /
title: "The Mexico Brief"
description: "The major developments in Mexico, the numbers moving today, and the dates coming next — with links to the original sources."
ogTitle: "The Mexico Brief"
ogDescription: "Mexico's major developments, key numbers, and original sources."
---
<style>
  .home{max-width:var(--maxw);margin:0 auto;padding:0 clamp(18px,4vw,44px)}
  .home a{text-underline-offset:3px}
  /* §5: the page nameplate. The nav keeps the wordmark; this is the paper's own
     head — name left, date right, one 2px ink rule, status line beneath it. */
  /* The head says two things and nothing else: what day it is, and when the page
     last refreshed. The masthead already carries the name. */
  .home-head{padding:28px 0 12px;border-bottom:1px solid var(--line)}
  .home-row{display:flex;align-items:baseline;justify-content:space-between;gap:8px 24px;flex-wrap:wrap}
  .home-date{font-size:22px;font-weight:600;letter-spacing:-.015em;color:var(--ink)}
  .home-tag{font-size:var(--fs-small);line-height:1.5;color:var(--ink-2);margin:6px 0 0;max-width:76ch}
  .home-updated{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);font-variant-numeric:tabular-nums}
  .home-updated .stale-note{color:var(--red);font-weight:650}
  .kicker{font-family:var(--mono);font-size:var(--fs-label);font-weight:650;letter-spacing:.055em;text-transform:uppercase;color:var(--green-d)}
  .section-top{display:flex;align-items:baseline;justify-content:space-between;gap:12px 20px;flex-wrap:wrap}
    /* Section heads read as labels, not headlines: mono, tracked, with the clock
     line beside them and one hairline under the pair. */
  .section-top{align-items:baseline;border-bottom:1px solid var(--ink);padding-bottom:9px}
  .section-title{font-family:var(--mono);font-size:13px;font-weight:700;line-height:1;letter-spacing:.18em;text-transform:uppercase;color:var(--ink);margin:0}
  .section-note{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut)}
  .section-note,.asof{font-family:var(--mono);font-size:var(--fs-label);color:var(--mut)}
  .text-link{font-family:var(--mono);font-size:var(--fs-label);color:var(--green-d)}

  .brief{border-bottom:1px solid var(--line);padding:4px 0 20px;margin-top:22px}
  .brief-copy{font-size:clamp(18px,1.65vw,22px);line-height:1.58;color:var(--ink-2);max-width:78ch;margin-top:13px}
  .brief-view{font-size:var(--fs-small);line-height:1.55;color:var(--ink-2);max-width:76ch;margin-top:13px;padding-left:14px;border-left:2px solid var(--green)}
  .brief-view b{color:var(--ink)}
  .brief-sources{display:flex;align-items:center;gap:5px 14px;flex-wrap:wrap;margin-top:14px;font-family:var(--mono);font-size:11px;color:var(--mut)}
  .brief-sources a{color:var(--green-d)}

  .news{margin-top:44px;max-width:920px}
  .story-list{border-top:1px solid var(--line);margin-top:12px}
  .brief-story{padding:17px 0;border-bottom:1px solid var(--line);background:transparent}
  /* The meta stacks in a rail beside the story: NEW, section, date, outlet —
     one per line, so the reading column stays uninterrupted. */
  .brief-story{display:grid;grid-template-columns:118px minmax(0,1fr);gap:0 24px}
  .story-meta{display:block;font-family:var(--mono);font-size:9px;line-height:1.5;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);font-variant-numeric:tabular-nums;padding-top:3px}
  .story-meta>*{display:block}
  .story-topic{color:var(--ink);font-weight:600;letter-spacing:.09em;text-decoration:none;padding-bottom:3px}
  .story-topic:hover{color:var(--green-d)}
  .new-badge{font-family:var(--mono);font-size:9px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--green);padding-bottom:4px}
  .brief-story.carried{opacity:.78}
  /* The BE column is RESERVED even when a story has no BE yet (it may still be analysing),
     so thumbnails and text keep one right edge down the whole page instead of jumping 44px. */
  .story-title-row{display:grid;grid-template-columns:minmax(0,1fr) 44px;gap:10px;align-items:start}
  /* Story thumbnail: the article's own link-preview image — tucked top-right of the story
     with the headline and summary wrapping beside it (news-list convention), same size on
     every screen. Clicks through to the source named on the meta line; removed if it fails. */
  .story-copy{display:flow-root}
  .story-thumb{float:right;width:132px;height:88px;margin:4px 0 10px 14px;border-radius:4px;overflow:hidden;background:var(--paper-2)}
  .story-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  @media(max-width:650px){.story-thumb{width:112px;height:74px;margin:3px 0 8px 12px}}
  .story-copy{min-width:0}
  /* §9: serif is a link, mono is a label. Headlines are the only hover target. */
  .story-link{color:var(--ink);text-decoration:none;cursor:pointer}
  .story-link:hover h3{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
  /* §2: rank by size — lead 23, second 20, the rest 18. Supersedes the 2026-07-17
     "all uniform" choice, which flattened the page's reading order. */
  .brief-story h3{font-size:18px;font-weight:400;line-height:1.34;letter-spacing:0;margin:0;max-width:60ch;text-wrap:pretty}
  .brief-story.rank-0 h3{font-size:23px;font-weight:500;letter-spacing:-.02em;line-height:1.28}
  .brief-story.rank-1 h3{font-size:20px;font-weight:500;letter-spacing:-.012em;line-height:1.3}
  .story-summary{font-size:15.5px;line-height:1.55;color:var(--ink-2);max-width:72ch;margin:7px 0 0;text-wrap:pretty}

  .context{position:relative;z-index:2}
  .context[open]{z-index:30}
  .context summary{white-space:nowrap}
  /* Same BE, same skin: the market popover wears the story panel's dress (panel background,
     green left rule, same type) so BE reads as ONE feature everywhere — only the floating
     position and shadow differ, because a stat card has no room for an inline panel. */
  .context-pop{display:none;position:absolute;right:0;top:42px;width:min(440px,calc(100vw - 48px));padding:13px 16px;background:#f8f7f2;border:1px solid var(--line);border-left:2px solid var(--green);border-radius:6px;box-shadow:0 10px 28px rgba(0,0,0,.09);font-size:14px;line-height:1.56;color:var(--ink-2);font-weight:400;text-align:left;z-index:20}
  .context-pop p+p{margin-top:8px;padding-top:8px;border-top:1px solid var(--line)}
  .context-pop .context-source{font-family:var(--mono);font-size:10px;color:var(--mut)}
  .context-pop .ck{font-family:var(--mono);font-size:10px;font-weight:650;letter-spacing:.05em;text-transform:uppercase;color:var(--green-d);margin-right:7px}
  .context[open] .context-pop{display:block}
  /* Briefly Explained accordion (Alan 2026-07-17): the BE button stays put; the panel
     opens full-width below the story and closes on second-click / outside-click / Esc —
     no chasing a button that moved. Market cards keep the compact .context popover above. */
  .be-btn[aria-expanded="true"] .be-mark{background:var(--green);border-color:var(--green);color:#fff}
  .be-panel{margin:13px 0 2px;padding:13px 16px;background:#f8f7f2;border-left:2px solid var(--green);font-size:14px;line-height:1.56;color:var(--ink-2)}
  .be-panel[hidden]{display:none}
  .be-panel p+p{margin-top:9px;padding-top:9px;border-top:1px solid var(--line)}
  .be-panel .ck{font-family:var(--mono);font-size:10px;font-weight:650;letter-spacing:.05em;text-transform:uppercase;color:var(--green-d);margin-right:7px}
  /* Background, Drivers and Implications are the contract — always all three. "What's next"
     is an explicit extra, present only when the article states a real next step (most news
     does not). The arrow marks it as forward-looking so a story without one reads complete. */
  .be-panel .be-next .ck::before{content:'\2192\00a0';color:var(--green)}
  .all-news{margin-top:24px;border-bottom:1px solid var(--line)}
  .all-news>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0;color:var(--green-d);font-family:var(--mono);font-size:var(--fs-label);font-weight:650;letter-spacing:.035em;text-transform:uppercase;cursor:pointer}
  .all-news>summary::-webkit-details-marker{display:none}
  .all-news>summary::after{content:'+';font-size:17px;line-height:1}
  .all-news[open]>summary::after{content:'–'}
  .all-news-body{padding:2px 0 12px}
  .filters{display:flex;flex-wrap:wrap;gap:8px;padding:12px 0 14px;border-bottom:1px solid var(--line)}
  .filters::-webkit-scrollbar{display:none}
  .filter{flex:0 0 auto;white-space:nowrap;border:1px solid var(--line-2);border-radius:999px;background:#fff;color:var(--ink-2);padding:8px 14px;min-height:34px;font-size:13px;line-height:1;cursor:pointer;transition:border-color .12s,color .12s}
  .filter:hover{border-color:var(--ink);color:var(--ink)}
  .filter.active{background:var(--green);border-color:var(--green);color:#fff;font-weight:600}
  .all-story[hidden]{display:none}
  .grp .brief-story{padding:14px 0}
  .grp .brief-story h3{font-size:clamp(17px,1.25vw,19px);line-height:1.34}
  .grp .story-summary{font-size:14.5px;margin-top:5px}
  .tag-above{color:var(--mut)}
  .grp-foot{display:flex;align-items:center;justify-content:space-between;gap:14px 20px;flex-wrap:wrap;border-top:1px solid var(--line);padding:11px 0 2px}
  .grp-more{background:none;border:0;padding:0;color:var(--green-d);font-family:var(--mono);font-size:var(--fs-label);font-weight:650;letter-spacing:.035em;text-transform:uppercase;cursor:pointer}
  .grp-more:hover{color:var(--green)}
  .grp-more[hidden]{display:none}
  .grp[hidden]{display:none}
  .grp-extra[hidden]{display:none}
  .grp-foot{padding:12px 0 2px}
  .new-badge{display:inline-block;background:var(--green);color:#fff;border-radius:3px;padding:2px 6px;font-size:9.5px;font-weight:700;letter-spacing:.06em}
  .new-count{color:var(--green-d)}
  .stale-note{color:var(--red);font-weight:650}
  .empty{font-size:var(--fs-small);color:var(--mut);padding:24px 0}
  .show-more{display:block;width:100%;margin-top:2px;padding:13px 0;background:none;border:0;border-top:1px solid var(--line);color:var(--green-d);font-family:var(--mono);font-size:var(--fs-label);font-weight:650;letter-spacing:.035em;text-transform:uppercase;cursor:pointer}
  .show-more:hover{color:var(--green)}
  .show-more[hidden]{display:none}

  .weeknews{margin-top:44px;max-width:920px}
  .markets{margin-top:34px}
  .week,.subscribe-section{margin-top:44px}
  .markets{border-top:2px solid var(--green);padding-top:14px}
  .market-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid var(--line);border-radius:5px;overflow:visible;margin-top:14px}
  .market-card{position:relative;min-width:0;padding:13px 15px 12px;background:var(--paper)}
  .market-card+.market-card{border-left:1px solid var(--line)}
  .market-link{display:block;color:inherit;text-decoration:none}
  .market-name{font-family:var(--mono);font-size:11px;line-height:1.3;text-transform:uppercase;letter-spacing:.035em;color:var(--mut);padding-right:94px}
  .market-value{font-variant-numeric:tabular-nums;font-size:clamp(26px,2.6vw,33px);font-weight:650;line-height:1.05;letter-spacing:-.022em;margin-top:8px;font-variant-numeric:tabular-nums;white-space:nowrap}
  .market-unit{font-family:var(--mono);font-size:10px;color:var(--mut);letter-spacing:0;margin-left:3px}
  .market-move{font-size:13px;line-height:1.35;font-weight:650;margin-top:8px;font-variant-numeric:tabular-nums}
  .market-move.up{color:var(--green-d)}
  .market-move.down{color:var(--red)}
  .market-move.flat{color:var(--mut);font-weight:400}
  .market-compare{font-size:12px;line-height:1.4;color:var(--ink-2);margin-top:3px;min-height:32px}
  .market-date{font-size:12px;line-height:1.45;color:var(--mut);margin-top:9px;font-variant-numeric:tabular-nums}
  .market-card>.context{position:absolute;right:13px;top:12px}
  /* Keep the market popover on-screen: it was clipping off the left edge on the leftmost
     card (Alan 2026-07-17). Left-half cards open rightward; right-half keep the default (left). */
  .market-card:nth-child(-n+2) .context-pop{left:0;right:auto}
  .market-floor .market-compare{min-height:0}

  .week{border-top:1px solid var(--line);padding-top:14px}
  .timeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:13px}
  .timeline-item{padding:14px 16px 15px 0}
  .timeline-item+.timeline-item{border-left:1px solid var(--line);padding-left:18px}
  .timeline-date{font-size:var(--fs-body);font-weight:700;letter-spacing:-.01em;color:var(--ink);font-variant-numeric:tabular-nums}
  .timeline-rel{font-family:var(--mono);font-size:var(--fs-label);color:var(--mut);margin-top:2px}
  .timeline-rel:empty{display:none}
  .timeline-title{font-size:var(--fs-small);line-height:1.35;font-weight:650;margin-top:6px}
  .timeline-why{font-size:var(--fs-meta);line-height:1.48;color:var(--ink-2);margin-top:5px}
  .timeline-source{display:inline-block;font-family:var(--mono);font-size:10px;color:var(--mut);margin-top:8px}

  /* The email block: one sentence saying what it is, then a form that reads as a
     single control. No card — the section rule already separates it. */
  .sub{border-top:1px solid var(--ink);padding-top:16px;max-width:620px}
  .sub .line{font-size:var(--fs-body);line-height:1.5;color:var(--ink);margin-top:8px;max-width:52ch}
  .sub .line a{color:var(--green-d);font-size:var(--fs-small)}
  .sub form{display:flex;margin-top:16px;border:1px solid var(--line-2);border-radius:6px;overflow:hidden;background:#fff}
  .sub form:focus-within{border-color:var(--ink)}
  .sub input[type=email]{flex:1;min-width:0;font-family:var(--sans);font-size:var(--fs-small);padding:13px 14px;border:0;background:transparent;color:var(--ink)}
  .sub input[type=email]:focus{outline:none}
  .sub button{font-family:var(--mono);font-size:var(--fs-label);letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#fff;background:var(--green);border:0;padding:13px 22px;cursor:pointer;white-space:nowrap}
  .sub button:hover{background:#075c39}
  .sub .fine{font-family:var(--mono);font-size:9px;letter-spacing:.04em;color:var(--mut);margin-top:10px}

  @media(max-width:900px){
    .market-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .market-card:nth-child(3){border-left:0;border-top:1px solid var(--line)}
    .market-card:nth-child(4){border-top:1px solid var(--line)}
    .market-card:nth-child(odd) .context-pop{left:0;right:auto}
    .market-card:nth-child(even) .context-pop{left:auto;right:0}
    .timeline{grid-template-columns:repeat(2,minmax(0,1fr))}
    .timeline-item:nth-child(3){border-left:0;border-top:1px solid var(--line);padding-left:0}
    .timeline-item:nth-child(4){border-top:1px solid var(--line)}
  }
  @media(max-width:650px){
    .home-head{padding-top:24px}
    .brief{margin-top:22px}
    .brief-copy{font-size:18px;line-height:1.52}
    .news{margin-top:30px}
    .weeknews{margin-top:32px}
    .filters{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
    .filters::-webkit-scrollbar{display:none}
    .brief-story{display:block}
    .story-meta{display:flex;flex-wrap:wrap;gap:2px 10px;padding:0 0 6px}
    .story-meta>*{display:inline}
    .story-topic{padding-bottom:0}
    .new-badge{padding-bottom:0}
    .brief-story{padding:15px 0}
    .brief-story h3{font-size:20px;line-height:1.32;font-weight:600}
    .grp .brief-story{padding:13px 0}
    .grp .brief-story h3{font-size:17.5px;line-height:1.34}
    .grp .story-summary{font-size:14px}
    .markets,.week,.subscribe-section{margin-top:34px}
    .story-title-row{grid-template-columns:1fr}
    .story-title-row>.be-btn{justify-self:start}
    .market-grid{grid-template-columns:1fr}
    .market-card+.market-card,.market-card:nth-child(3){border-left:0;border-top:1px solid var(--line)}
    /* On phones the popover was anchored to the tiny BE box and ran off the right edge.
       Make it a bottom sheet: fixed, full-width, never clipped, tap it or away to close. */
    .market-card .context-pop{position:fixed;left:14px;right:14px;bottom:14px;top:auto;width:auto;max-width:none;box-shadow:0 -6px 28px rgba(0,0,0,.16)}
    .market-value{font-size:32px}
    .market-compare{min-height:0}
    .timeline{grid-template-columns:1fr}
    .timeline-item,.timeline-item+.timeline-item,.timeline-item:nth-child(3),.timeline-item:nth-child(4){padding:14px 0 15px;border-left:0;border-top:1px solid var(--line)}
    .timeline-item:first-child{border-top:0}
  }
</style>

<div class="home">
  <header class="home-head">
    <div class="home-row">
      <div class="home-date" id="today">Saturday, August 1, 2026</div>
      <div class="home-updated" id="updated" data-date="{{ dailyBrief.newsThrough }}"></div>
    </div>
    <p class="home-tag">Mexico's economic, political, security and business news, all in one place.</p>
  </header>

  <section class="brief" aria-labelledby="brief-title">
    <div class="section-top"><div class="kicker" id="brief-title">The brief</div></div>
    <p class="brief-copy">{{ dailyBrief.summaryLead }}</p>
    {% if dailyBrief.view %}<p class="brief-view"><b>My view:</b> {{ dailyBrief.view }}</p>{% endif %}
    {% if dailyBrief.briefSources.length %}<div class="brief-sources"><span>Sources:</span>{% for item in dailyBrief.briefSources %}<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.source }} ↗</a>{% endfor %}</div>{% endif %}
  </section>

  <section class="markets" aria-labelledby="markets-title">
    <div class="section-top"><div><h2 class="section-title" id="markets-title">Markets today</h2></div><a class="text-link" href="/chart.html">All numbers →</a></div>
    <div class="market-grid market-floor" id="market-grid">
      {% for item in nowBoard %}<article class="market-card"><a class="market-link" href="{{ item.href }}"><div class="market-name">{{ item.label }}</div><div class="market-value">{{ item.display }}</div><div class="market-date"><span class="js-date" data-date="{{ item.date }}">{{ item.date }}</span></div></a></article>{% endfor %}
    </div>
  </section>


  <section class="news" aria-labelledby="news-title">
    <div class="section-top"><div><h2 class="section-title" id="news-title">Top stories</h2></div><span class="section-note">Last 48 hours · {% if dailyBrief.newCount %}<b class="new-count">{{ dailyBrief.newCount }} new since yesterday</b>{% else %}nothing new since yesterday{% endif %}</span></div>
    <div class="be-key"><span class="be-mark" aria-hidden="true">BE</span><span>The context behind the headline.</span></div>
    <div class="story-list major-list">
      {% for story in dailyBrief.stories %}
      <article class="brief-story rank-{{ loop.index0 if loop.index0 < 2 else 2 }}{% if not story.isNew %} carried{% endif %}">
        <div class="story-meta">{% if story.isNew %}<span class="new-badge">New</span>{% endif %}<a class="story-topic" href="{{ story.topicUrl }}">{{ story.beat }}</a><span class="js-storydate" data-date="{{ story.date }}">{{ story.date }}</span>{% if story.source %}<span>{{ story.source }}</span>{% endif %}</div>
        <div class="story-title-row">
          <div class="story-copy">{% if story.image %}<a class="story-thumb" href="{{ story.url }}" target="_blank" rel="noopener" title="Image: {{ story.source }}" aria-hidden="true" tabindex="-1"><img src="{{ story.image }}" alt="" loading="lazy" referrerpolicy="no-referrer" /></a>{% endif %}<a class="story-link" href="{{ story.url }}" target="_blank" rel="noopener"><h3>{{ story.title }}</h3></a>{% if story.summary %}<p class="story-summary">{{ story.summary }}</p>{% endif %}</div>
          {% if story.bg and story.drivers and story.implications %}<button class="be-summary be-btn" type="button" aria-expanded="false" aria-label="Context behind the headline" title="The context behind the headline"><span class="be-mark" aria-hidden="true">BE</span></button>{% endif %}
        </div>
        {% if story.bg and story.drivers and story.implications %}<div class="be-panel" hidden><p><span class="ck">Background</span>{{ story.bg }}</p><p><span class="ck">Drivers</span>{{ story.drivers }}</p><p><span class="ck">Implications</span>{{ story.implications }}</p>{% if story.next %}<p class="be-next"><span class="ck">What's next</span>{{ story.next }}</p>{% endif %}</div>{% endif %}
      </article>
      {% endfor %}
    </div>

  </section>

  <section class="weeknews" id="all-news" aria-labelledby="weeknews-title">
    <div class="section-top"><div><h2 class="section-title" id="weeknews-title">Top headlines, last 7 days</h2></div></div>
    <nav class="filters" aria-label="Choose a section">
      {% for group in weeklyTop.groups %}<button class="filter{% if loop.first %} active{% endif %}" type="button" data-topic="{{ group.key }}">{{ group.label }}</button>{% endfor %}
    </nav>
    {% for group in weeklyTop.groups %}
    <section class="grp" data-key="{{ group.key }}"{% if not loop.first %} hidden{% endif %}>
      {% if group.items.length %}
      <div class="story-list">
        {% for story in group.items %}
        <article class="brief-story all-story{% if loop.index > 5 %} grp-extra{% endif %}"{% if loop.index > 5 %} hidden{% endif %}>
          <div class="story-meta"><a class="story-topic" href="{{ group.href }}">{{ group.label }}</a><span>{{ story.dayLabel }}</span><span>{{ story.sourceName }}</span>{% if story.shownToday %}<span class="tag-above">shown today</span>{% endif %}</div>
          <div class="story-copy"><a class="story-link" href="{{ story.url }}" target="_blank" rel="noopener"><h3>{{ story.title }}</h3></a>{% if story.dek %}<p class="story-summary">{{ story.dek }}</p>{% endif %}</div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="empty">A quiet week here: nothing from the named outlets cleared the bar.</p>
      {% endif %}
      <div class="grp-foot">{% if group.items.length > 5 %}<button class="grp-more" type="button">Show {{ group.items.length - 5 }} more</button>{% else %}<span></span>{% endif %}<a class="text-link" href="{{ group.href }}">Everything in {{ group.label }} →</a></div>
    </section>
    {% endfor %}
  </section>

  <section class="week" aria-labelledby="week-title">
    <div class="section-top"><div><h2 class="section-title" id="week-title">The week ahead</h2></div><span class="section-note">Official releases and meetings</span></div>
    <div class="timeline">
      {% for event in calendar %}<article class="timeline-item"><div class="timeline-date">{% if event.approx %}Week of <span class="js-date" data-date="{{ event.date }}">{{ event.date }}</span>{% else %}<span class="js-caldate" data-date="{{ event.date }}">{{ event.date }}</span>{% endif %}</div><div class="timeline-rel js-rel" data-date="{{ event.date }}" data-approx="{{ 'y' if event.approx else '' }}"></div><div class="timeline-title">{{ event.title }}</div>{% if event.why %}<div class="timeline-why">{{ event.why }}</div>{% endif %}{% if event.sourceUrl %}<a class="timeline-source" href="{{ event.sourceUrl }}" target="_blank" rel="noopener">{{ event.source }} ↗</a>{% else %}<div class="timeline-source">{{ event.source }}</div>{% endif %}</article>{% endfor %}
    </div>
  </section>

  <section class="subscribe-section">
    <div class="sub"><div class="kicker">The email</div><p class="line">What changed in Mexico, once a week. <a href="/weekly.html">See an example →</a></p><form class="subform" method="post" action="/api/subscribe" novalidate><input type="email" name="email" placeholder="you@email.com" aria-label="Email address" autocomplete="email" inputmode="email" required /><label class="hp-field" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label><button type="submit">Subscribe</button></form><div class="fine submsg" aria-live="polite">Unsubscribe whenever you want.</div></div>
  </section>
</div>

<script type="module">
import { loadSeries, S, relTime } from '/assets/mb.js?v=18';

const esc=(value)=>String(value==null?'':value).replace(/[&<>\"]/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));
const last=(id)=>S[id]?.data?.at(-1)||null;
const prior=(id)=>S[id]?.data?.at(-2)||null;
const nearAgo=(id,days)=>{const rows=S[id]?.data||[];if(!rows.length)return null;const target=Date.parse(rows.at(-1).date)-days*864e5;let best=null,dist=Infinity;for(const row of rows){const d=Math.abs(Date.parse(row.date)-target);if(d<dist){dist=d;best=row;}}return dist<45*864e5?best:null;};
const num=(value,digits=2)=>Number(value).toLocaleString('en-US',{minimumFractionDigits:digits,maximumFractionDigits:digits});
const date=(iso,year=false)=>{if(!iso)return'';const d=new Date(/^\d{4}-\d{2}-\d{2}$/.test(iso)?iso+'T00:00:00':iso);return isNaN(d)?iso:d.toLocaleDateString('en-US',{month:'short',day:'numeric',...(year?{year:'numeric'}:{})});};

// Briefly Explained (Alan 2026-07-17): story rows use a button+panel accordion — the BE
// button stays in place, the panel opens full-width below the story, and it closes on a
// second click, a click anywhere outside, or Esc (no chasing a moved button). Market cards
// keep their compact <details> popover but gain the same outside-click / Esc dismissal.
// One open at a time across both.
function beCloseAll(except){
  document.querySelectorAll('.be-btn[aria-expanded="true"]').forEach((b)=>{if(b!==except){b.setAttribute('aria-expanded','false');const p=b.closest('.brief-story')?.querySelector(':scope > .be-panel');if(p)p.hidden=true;}});
  document.querySelectorAll('details.context[open]').forEach((d)=>{if(d!==except)d.open=false;});
}
document.querySelectorAll('.be-btn').forEach((btn)=>{
  const panel=btn.closest('.brief-story')?.querySelector(':scope > .be-panel');
  if(!panel)return;
  btn.addEventListener('click',(e)=>{e.stopPropagation();const isOpen=btn.getAttribute('aria-expanded')==='true';beCloseAll(isOpen?null:btn);btn.setAttribute('aria-expanded',String(!isOpen));panel.hidden=isOpen;});
});
// Outside-dismissal is DELEGATED, not bound per element. The market cards render after
// this script runs (they wait on live data), so binding stopPropagation on their buttons
// at init silently missed them — the document click handler then closed the popover the
// native toggle was reopening, and a second click on BE could never close it (Alan
// 2026-07-20: "no way to click out of it"). One document-level pointerdown now closes
// every open BE unless the press is on a BE control or inside a story panel; the controls'
// own click handlers (and the native <details> toggle) keep sole charge of toggling.
// pointerdown rather than click because iPhone Safari does not reliably fire document
// clicks for taps on non-interactive elements — the other half of "can't dismiss on my phone".
document.addEventListener('pointerdown',(e)=>{
  if(e.target.closest?.('.be-btn, .be-panel, details.context > summary'))return;
  beCloseAll(null);
});
document.addEventListener('keydown',(e)=>{if(e.key==='Escape')beCloseAll(null);});
// Opening a market-card popover closes any other open BE.
document.addEventListener('toggle',(event)=>{const d=event.target;if(d.matches?.('details.context')&&d.open)beCloseAll(d);},true);

// The last 7 days: one section list at a time, chosen by the chips; ?topic=
// persists the choice. Replaces the old 5-topic filter — same pills, new flow.
const newsFilters=[...document.querySelectorAll('.filter')];
const groups=[...document.querySelectorAll('.grp')];
function showNews(topic,push=false){
  const valid=groups.some((g)=>g.dataset.key===topic)?topic:groups[0]?.dataset.key;
  newsFilters.forEach((b)=>b.classList.toggle('active',b.dataset.topic===valid));
  groups.forEach((g)=>{g.hidden=g.dataset.key!==valid;});
  if(push){const url=new URL(location.href);url.searchParams.set('topic',valid);url.hash='all-news';history.replaceState({},'',url);}
}
newsFilters.forEach((button)=>button.addEventListener('click',()=>showNews(button.dataset.topic,true)));
document.querySelectorAll('.grp-more').forEach((btn)=>{
  btn.addEventListener('click',()=>{btn.closest('.grp')?.querySelectorAll('.grp-extra').forEach((row)=>{row.hidden=false;});btn.hidden=true;});
});
showNews(new URLSearchParams(location.search).get('topic')||groups[0]?.dataset.key);
// §9: the selected chip pins itself to the left edge so ?topic= reads without a swipe.
(()=>{const nav=document.querySelector('.filters'),on=document.querySelector('.filter.active');
  if(nav&&on&&nav.scrollWidth>nav.clientWidth)nav.scrollLeft=Math.max(0,on.offsetLeft-nav.offsetLeft-4);})();

// §3/§9 (spec 2026-08-01): the sign carries direction, the colour carries whether
// it is good or bad for Mexico, and the plain word stays. A zero move is not a
// move: "unchanged", meta grey, no sign, no colour. No arrows anywhere.
const moveText=(raw,digits,unit,goodWhenDown,words)=>{
  if(raw==null)return{move:'unchanged',direction:'flat'};
  const mag=num(Math.abs(raw),digits);
  if(Number(String(mag).replace(/,/g,''))===0)return{move:'unchanged',direction:'flat'};
  const good=goodWhenDown?raw<0:raw>0;
  const word=words?` · ${raw<0?words[0]:words[1]}`:'';
  return{move:`${raw<0?'−':'+'}${mag}${unit} today${word}`,direction:good?'up':'down'};
};
function card({id,name,value,unit='',move='',direction='flat',compare='',stamp,context,source}){
  return `<article class="market-card"><a class="market-link" href="/chart.html?v=${esc(id)}"><div class="market-name">${esc(name)}</div><div class="market-value">${esc(value)}${unit?`<span class="market-unit">${esc(unit)}</span>`:''}</div><div class="market-move ${esc(direction)}">${esc(move)}</div>${compare?`<div class="market-compare">${esc(compare)}</div>`:'<div class="market-compare"></div>'}<div class="market-date">${esc(stamp)}</div></a><details class="context"><summary class="be-summary" aria-label="Context behind the headline" title="The context behind the headline"><span class="be-mark" aria-hidden="true">BE</span></summary><div class="context-pop"><p><span class="ck">Background</span>${esc(context)}</p><p class="context-source">Source: ${esc(source)}</p></div></details></article>`;
}

function renderMarkets(){
  const cards=[];
  const peso=last('banxico-usdmxn-fix'),pesoP=prior('banxico-usdmxn-fix'),pesoY=nearAgo('banxico-usdmxn-fix',365);
  if(peso){const change=pesoP?(peso.value/pesoP.value-1)*100:null;const year=pesoY?(peso.value/pesoY.value-1)*100:null;const m=moveText(change,2,'%',true,['stronger','weaker']);cards.push(card({id:'banxico-usdmxn-fix',name:'Peso · per US dollar',value:num(peso.value),move:m.move,direction:m.direction,compare:year==null?'':`${num(Math.abs(year),1)}% ${year<0?'stronger':'weaker'} than a year ago`,stamp:`As of ${date(peso.date,true)} · updates each trading day`,context:'A lower number means a stronger peso. Imports become cheaper, while each dollar earned by exporters or sent home as a remittance converts into fewer pesos.',source:'Banco de México (FIX)'}));}
  const ipc=last('banxico-bmv-ipc'),ipcP=prior('banxico-bmv-ipc'),ipcY=nearAgo('banxico-bmv-ipc',365);
  if(ipc){const change=ipcP?(ipc.value/ipcP.value-1)*100:null;const year=ipcY?(ipc.value/ipcY.value-1)*100:null;const m=moveText(change,2,'%',false,null);cards.push(card({id:'banxico-bmv-ipc',name:'S&P/BMV IPC',value:num(ipc.value,0),move:m.move,direction:m.direction,compare:year==null?'':`${num(Math.abs(year),1)}% ${year>=0?'higher':'lower'} than a year ago`,stamp:`As of ${date(ipc.date,true)} close · updates each trading day`,context:'Mexico’s main stock index. It tracks large listed companies, so it is useful for market sentiment but should not be read as the whole economy.',source:'Banco de México / BMV'}));}
  const cetes=last('banxico-cetes-28d'),cetesP=prior('banxico-cetes-28d');
  if(cetes){const change=cetesP?cetes.value-cetesP.value:null;const m=moveText(change,2,' points',true,null);cards.push(card({id:'banxico-cetes-28d',name:'Cetes · 28 days',value:`${num(cetes.value)}%`,move:m.move,direction:m.direction,compare:'Short-term Mexican government debt',stamp:`As of ${date(cetes.date,true)} · updates each trading day`,context:'The market yield on very short-term Mexican government debt. It can move between Banxico meetings and is a useful check on near-term rate expectations.',source:'Banco de México'}));}
  const ust=last('fred-ust10'),ustP=prior('fred-ust10');
  if(ust){const change=ustP?ust.value-ustP.value:null;const m=moveText(change,2,' points',true,null);cards.push(card({id:'fred-ust10',name:'U.S. 10-year',value:`${num(ust.value)}%`,move:m.move,direction:m.direction,compare:'Benchmark for dollar borrowing costs',stamp:`As of ${date(ust.date,true)} · updates each trading day`,context:'Higher U.S. yields can make peso assets relatively less attractive and raise dollar borrowing costs for Mexican companies. They are one input, not a complete explanation for the peso.',source:'Federal Reserve (FRED)'}));}
  const grid=document.getElementById('market-grid');if(grid&&cards.length){grid.classList.remove('market-floor');grid.innerHTML=cards.join('');}
}

document.getElementById('today').textContent=new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
document.querySelectorAll('.js-date').forEach((el)=>{el.textContent=date(el.dataset.date);});
// Story dates read as WHEN, plainly (Alan 2026-07-17: "make the date more clear"): Today /
// Yesterday for the fresh ones, weekday + date for the rest — so it's obvious a top story
// dated yesterday is yesterday's, not today's.
const storyDate=(iso)=>{const d=new Date(/^\d{4}-\d{2}-\d{2}$/.test(iso)?iso+'T00:00:00':iso);if(isNaN(d))return iso;const t=new Date();t.setHours(0,0,0,0);const n=Math.round((t-d)/864e5);if(n<=0)return'Today';if(n===1)return'Yesterday';if(n<=6)return d.toLocaleDateString('en-US',{weekday:'short'})+', '+d.toLocaleDateString('en-US',{month:'short',day:'numeric'});return d.toLocaleDateString('en-US',{month:'short',day:'numeric'});};
document.querySelectorAll('.js-storydate').forEach((el)=>{el.textContent=storyDate(el.dataset.date);});
// The "Top stories" window — answers "these are from when?" (they're ranked by importance,
// so the newest isn't always first). Derived from the oldest story shown.
const newsWin=document.getElementById('news-window');const topDates=document.querySelectorAll('.major-list .js-storydate');
if(newsWin&&topDates.length){const times=[...topDates].map((el)=>Date.parse(el.dataset.date+'T00:00:00')).filter((x)=>!isNaN(x));if(times.length){const t=new Date();t.setHours(0,0,0,0);const days=Math.max(1,Math.round((t-Math.min(...times))/864e5)+1);newsWin.textContent=days<=1?'Today':`Past ${days} days`;}}
// Calendar dates carry the WEEKDAY (so "Jul 23" isn't a floating number) plus a relative
// "how far from now" line — the anchor that answers "what week is this" (Alan 2026-07-17).
const calDate=(iso)=>{if(!iso)return'';const d=new Date(/^\d{4}-\d{2}-\d{2}$/.test(iso)?iso+'T00:00:00':iso);return isNaN(d)?iso:d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});};
document.querySelectorAll('.js-caldate').forEach((el)=>{el.textContent=calDate(el.dataset.date);});
const weekStart=(d)=>{const x=new Date(d.getTime());x.setHours(0,0,0,0);x.setDate(x.getDate()-((x.getDay()+6)%7));return x;};
const relDay=(iso,approx)=>{const d=new Date(iso+'T00:00:00');if(isNaN(d))return'';const t=new Date();t.setHours(0,0,0,0);const n=Math.round((d-t)/864e5);if(n<0)return'';if(approx){const w=Math.round((weekStart(d)-weekStart(t))/(7*864e5));return w<=0?'this week':w===1?'next week':'in '+w+' weeks';}if(n===0)return'today';if(n===1)return'tomorrow';return 'in '+n+' days';};
document.querySelectorAll('.js-rel').forEach((el)=>{el.textContent=relDay(el.dataset.date,el.dataset.approx==='y');});
// One update stamp for the whole page: when the brief last refreshed, in plain
// words, with the stale flag beside it. Everything else that used to report a
// clock (the data-checked line, the per-block stamps) is gone.
const upd=document.getElementById('updated');
if(upd){const d=new Date(upd.dataset.date);
  if(isNaN(d))upd.textContent='Not yet refreshed';
  else{const hrs=(Date.now()-d.getTime())/36e5;
    const when=hrs<24?`${d.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})} today`
      :hrs<48?`yesterday, ${d.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`
      :`${d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'})}`;
    upd.innerHTML=`Refreshed ${when}`+(hrs>48?` · <span class="stale-note">${Math.round(hrs/24)} days ago</span>`:'');}}

loadSeries(['banxico-usdmxn-fix','banxico-bmv-ipc','banxico-cetes-28d','fred-ust10']).then(()=>{
  renderMarkets();
}).catch(()=>{});

// Story thumbnails fail soft: a blocked or rotten image removes itself and the card
// reverts to text. The image is an enhancement, never a dependency.
document.querySelectorAll('.story-thumb img').forEach((img)=>{
  const kill=()=>{const t=img.closest('.story-thumb');if(t)t.remove();};
  if(img.complete&&img.naturalWidth===0)kill();else img.addEventListener('error',kill,{once:true});
});
</script>
