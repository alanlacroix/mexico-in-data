---
layout: base.njk
permalink: /
title: "The Mexico Brief"
description: "Today’s important Mexico headlines, the latest official numbers, and the connections between them, with links to the original sources."
ogTitle: "The Mexico Brief"
ogDescription: "Today’s Mexico headlines, official numbers, and the connections worth watching."
---
<style>
  .home{max-width:var(--maxw);margin:0 auto;padding:0 clamp(18px,3vw,40px);--gap-section:56px;--gap-item:18px}
  .home a{text-underline-offset:3px}
  /* THE GRID (Fable, 2026-08-02). Twelve columns, one spine. Rails live left of the
     prose; the prose column never reflows, so the measure is identical on every row
     whether or not a story came with art. Where there is no image, columns 10-12 hold
     whitespace: reserved alignment, never a drawn placeholder. Rules span all twelve. */
  .row12{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:22px}
  .home-head{padding:32px 0 15px;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:22px;border-bottom:1px solid var(--line)}
  .home-head>div{grid-column:1 / span 6}
  .home-title{font-size:clamp(25px,2.8vw,36px);font-weight:650;line-height:1.1;letter-spacing:-.025em;margin:0}
  .home-date{margin:0;font-family:var(--mono);font-size:clamp(22px,2.3vw,28px);font-weight:650;line-height:1.12;letter-spacing:-.012em;color:var(--ink)}
  .home-strap{margin:9px 0 0;font-size:var(--fs-small);line-height:1.45;color:var(--mut)}
  .kicker{font-family:var(--mono);font-size:var(--fs-label);font-weight:650;letter-spacing:.055em;text-transform:uppercase;color:var(--green-d)}
  .section-top{display:flex;align-items:baseline;justify-content:space-between;gap:12px 20px;flex-wrap:wrap}
  .section-title{font-size:var(--fs-h2);line-height:1.12;letter-spacing:-.018em;margin:5px 0 0}
  .section-note,.asof{font-family:var(--mono);font-size:var(--fs-label);color:var(--mut)}
  .text-link{font-family:var(--mono);font-size:var(--fs-label);color:var(--green-d)}

  .brief{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:22px;border-top:2px solid var(--green);border-bottom:1px solid var(--line);padding:16px 0 20px;margin-top:var(--gap-section);scroll-margin-top:72px}
  .brief>.section-top{grid-column:1 / -1}
  .brief>.brief-copy,.brief>.my-read,.brief>.source-state,.brief>.brief-sources{grid-column:3 / span 7}
  .brief-copy{font-size:clamp(18px,1.65vw,22px);line-height:1.58;color:var(--ink-2);margin-top:13px}
  .my-read{margin-top:17px;padding:13px 15px;border-left:2px solid var(--green);background:#f8f7f2}
  .my-read p{font-size:var(--fs-small);line-height:1.56;color:var(--ink-2)}
  .my-read strong{color:var(--ink)}
  .read-evidence{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
  .read-number{display:inline-flex;gap:6px;align-items:baseline;padding:6px 9px;border:1px solid var(--line);border-radius:4px;background:#fff;color:var(--ink);text-decoration:none;font-family:var(--mono);font-size:var(--fs-label)}
  .read-number b{font-size:var(--fs-label)}
  .read-story{display:inline-flex;align-items:center;padding:6px 9px;color:var(--green-d);font-family:var(--mono);font-size:var(--fs-label);text-decoration:none}
  .source-state{margin-top:13px;padding:11px 13px;border-left:2px solid var(--red);background:#fff7f7;font-size:var(--fs-small);line-height:1.5;color:var(--ink-2)}
  .source-state strong{color:var(--ink)}
  .source-state a{margin-left:8px;color:var(--green-d)}
  .brief-sources{display:flex;align-items:center;gap:5px 14px;flex-wrap:wrap;margin-top:14px;font-family:var(--mono);font-size:var(--fs-label);color:var(--mut)}
  .brief-sources a{color:var(--green-d)}

  .news{margin-top:var(--gap-section)}
  .story-list{border-top:1px solid var(--line);margin-top:var(--gap-item)}
  .brief-story{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:22px;align-items:start;padding:20px 0;border-bottom:1px solid var(--line);background:transparent}
  .story-meta{grid-column:1 / span 2;display:flex;flex-direction:column;gap:3px;font-family:var(--mono);font-size:var(--fs-label);line-height:1.35;color:var(--mut)}
  .story-meta>*{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .story-outlet{color:var(--mut)}
  .story-topic{font-weight:650;color:var(--ink);text-decoration:none}
  .sec-payments{color:var(--sec-payments)}
  .sec-deals{color:var(--sec-deals)}
  .sec-economy{color:var(--sec-economy)}
  .sec-usmexico{color:var(--sec-usmexico)}
  .sec-politics{color:var(--sec-politics)}
  .sec-society{color:var(--sec-society)}
  .sec-energy{color:var(--sec-energy)}
  .filter[data-topic="payments"].active{background:var(--sec-payments);border-color:var(--sec-payments)}
  .filter[data-topic="deals"].active{background:var(--sec-deals);border-color:var(--sec-deals)}
  .filter[data-topic="economy"].active{background:var(--sec-economy);border-color:var(--sec-economy)}
  .filter[data-topic="usmexico"].active{background:var(--sec-usmexico);border-color:var(--sec-usmexico)}
  .filter[data-topic="politics"].active{background:var(--sec-politics);border-color:var(--sec-politics)}
  .filter[data-topic="society"].active{background:var(--sec-society);border-color:var(--sec-society)}
  .filter[data-topic="energy"].active{background:var(--sec-energy);border-color:var(--sec-energy)}
  .story-title-row{grid-column:3 / span 7;min-width:0}
  .story-copy{display:flow-root;min-width:0}
  .story-thumb{grid-column:10 / span 3;display:block;aspect-ratio:300/190;border-radius:4px;overflow:hidden;background:var(--paper-2)}
  .story-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .story-link{color:var(--ink);text-decoration:none}
  .story-link:hover{color:var(--green-d)}
  .brief-story h3{font-size:clamp(18px,1.55vw,22px);line-height:1.32;letter-spacing:-.008em;font-weight:600;margin:0;max-width:60ch}
  .story-summary{font-size:var(--fs-small);line-height:1.5;color:var(--ink-2);max-width:70ch;margin:7px 0 0}
  .context-btn{display:inline-flex;align-items:center;justify-content:center;width:40px;min-height:36px;border:1px solid var(--line-2);border-radius:3px;background:#fff;color:var(--ink-2);padding:0;font-family:var(--mono);font-size:var(--fs-label);font-weight:700;cursor:pointer}
  .story-copy .context-btn{margin-top:11px}
  .context-btn:hover,.context-btn[aria-expanded="true"]{border-color:var(--ink);background:var(--ink);color:#fff}
  .be-key{display:inline-flex;align-items:center;gap:7px}
  .be-key b{display:inline-flex;align-items:center;justify-content:center;width:26px;height:23px;border:1px solid var(--line-2);border-radius:3px;color:var(--ink-2);font-size:var(--fs-label);}
  .story-context{grid-column:3 / -1;margin:13px 0 2px;padding:13px 16px;background:#f8f7f2;border-left:2px solid var(--green);font-size:var(--fs-small);line-height:1.56;color:var(--ink-2)}
  .story-context[hidden]{display:none}
  .story-context p+p,.story-context .coverage{margin-top:9px;padding-top:9px;border-top:1px solid var(--line)}
  .context-label{font-family:var(--mono);font-size:var(--fs-label);font-weight:650;color:var(--ink);margin-right:7px}
  .coverage-links{display:flex;gap:6px 12px;flex-wrap:wrap;margin-top:5px;font-family:var(--mono);font-size:var(--fs-label)}
  .coverage-links a{color:var(--green-d)}

  .all-news{margin-top:var(--gap-item);border-bottom:1px solid var(--line)}
  .all-news>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0;color:var(--ink);font-family:var(--mono);font-size:var(--fs-meta);font-weight:650;cursor:pointer}
  .all-news>summary::-webkit-details-marker{display:none}
  .all-news>summary::after{content:'+';font-size:17px;line-height:1}
  .all-news[open]>summary::after{content:'–'}
  .all-news-body{padding:2px 0 12px}
  .week-span{font-weight:400;letter-spacing:.02em;color:var(--mut);text-transform:none;margin-left:9px}
  .filters{display:flex;flex-wrap:wrap;gap:7px;padding:2px 0 13px;border-bottom:1px solid var(--line)}
  .filter{flex:0 0 auto;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--ink-2);padding:8px 13px;font-size:var(--fs-meta);cursor:pointer}
  .filter:hover{border-color:var(--ink-2);color:var(--ink)}
  .filter.active{border-color:var(--ink);color:#fff;background:var(--ink)}
  .all-story[hidden]{display:none}
  .empty{font-size:var(--fs-small);color:var(--mut);padding:24px 0}
  .show-more{display:block;width:100%;margin-top:2px;padding:13px 0;background:none;border:0;border-top:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:var(--fs-meta);font-weight:650;cursor:pointer}
  .show-more:hover{color:var(--green-d)}
  .show-more[hidden]{display:none}

  .markets,.week,.subscribe-section{margin-top:var(--gap-section)}
  .markets{border-top:2px solid var(--green);padding-top:14px}
  .market-rows{border-top:1px solid var(--line);margin-top:13px}
  .market-row{display:grid;grid-template-columns:minmax(0,1.05fr) auto minmax(0,1.5fr) auto;align-items:baseline;gap:6px 22px;padding:14px 0;border-bottom:1px solid var(--line);color:inherit;text-decoration:none}
  .market-row:hover .market-value{color:var(--green-d)}
  .market-name{font-family:var(--mono);font-size:var(--fs-label);line-height:1.3;color:var(--mut)}
  .market-figure{display:inline-flex;align-items:baseline;gap:6px;justify-self:end;white-space:nowrap}
  .market-value{font-size:var(--fs-h2);font-weight:650;line-height:1.05;letter-spacing:-.02em;font-variant-numeric:tabular-nums;color:var(--ink);transition:color .15s ease}
  .market-unit{font-family:var(--mono);font-size:var(--fs-label);color:var(--mut)}
  .market-compare{font-size:var(--fs-small);line-height:1.45;color:var(--ink-2)}
  .market-date{font-family:var(--mono);font-size:var(--fs-label);line-height:1.4;color:var(--mut);white-space:nowrap;justify-self:end}
  .market-note{font-family:var(--mono);font-size:var(--fs-label);line-height:1.5;color:var(--mut);margin-top:11px}

  /* The daily strip. Deliberately thinner than .market-card: three lines, no source
     row, no action row. It sits between the brief and the news, so it has to cost
     one band of screen, not a full one. */
  .pulse{margin-top:var(--gap-section)}
  .pulse-grid{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:13px}
  .pulse-item{min-width:0;padding:14px 16px 15px 0}
  .pulse-item+.pulse-item{border-left:1px solid var(--line);padding-left:16px}
  .pulse-link{display:block;color:inherit;text-decoration:none}
  .pulse-link:hover .pulse-value{color:var(--green-d)}
  .pulse-name{font-family:var(--mono);font-size:var(--fs-label);line-height:1.3;color:var(--mut)}
  .pulse-asof{font-family:var(--mono);font-size:var(--fs-label);line-height:1.4;color:var(--mut);margin-top:5px;white-space:nowrap}
  .pulse-value{font-size:clamp(22px,2.1vw,28px);font-weight:650;line-height:1.06;letter-spacing:-.025em;margin-top:8px;font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--ink);transition:color .15s ease}
  .pulse-unit{font-family:var(--mono);font-size:var(--fs-label);color:var(--mut);letter-spacing:0;margin-left:3px}
  .pulse-move{font-family:var(--mono);font-size:var(--fs-meta);line-height:1.4;color:var(--mut);margin-top:7px;font-variant-numeric:tabular-nums;white-space:nowrap}
  .pulse-date{font-family:var(--mono);font-size:var(--fs-label);line-height:1.4;color:var(--mut);margin-top:5px;white-space:nowrap}

  .week{border-top:1px solid var(--line);padding-top:14px}
  .timeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:13px}
  .timeline-item{padding:17px 18px 18px 0}
  .timeline-item+.timeline-item{border-left:1px solid var(--line);padding-left:18px}
  .timeline-date{font-size:var(--fs-body);font-weight:700;letter-spacing:-.01em;color:var(--ink)}
  .timeline-rel{font-family:var(--mono);font-size:var(--fs-label);color:var(--mut);margin-top:2px}
  .timeline-rel:empty{display:none}
  .timeline-title{font-size:var(--fs-small);line-height:1.35;font-weight:650;margin-top:6px}
  .timeline-why{font-size:var(--fs-meta);line-height:1.48;color:var(--ink-2);margin-top:5px}
  .timeline-source{display:inline-block;font-family:var(--mono);font-size:var(--fs-label);color:var(--mut);margin-top:8px}

  .sub{border:1px solid var(--line);border-radius:7px;padding:20px 22px 17px;background:#fbfaf6}
  .sub .line{font-size:var(--fs-small);color:var(--ink-2);margin-top:7px;line-height:1.5;max-width:74ch}
  .sub form{display:flex;gap:10px;flex-wrap:wrap;margin-top:13px}
  .sub input[type=email]{flex:1;min-width:220px;font-family:var(--sans);font-size:var(--fs-small);padding:12px 14px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink)}
  .sub button{font-family:var(--mono);font-size:var(--fs-label);letter-spacing:.05em;text-transform:uppercase;font-weight:700;color:#fff;background:var(--green);border:0;border-radius:7px;padding:12px 24px;cursor:pointer}
  .sub .fine{font-family:var(--mono);font-size:11px;color:var(--mut);margin-top:10px}

  @media(max-width:900px){
    .pulse-grid{grid-auto-flow:row;grid-template-columns:repeat(2,minmax(0,1fr))}
    .pulse-item,.pulse-item+.pulse-item{border-left:0;border-top:1px solid var(--line);padding:13px 14px 14px 0}
    .pulse-item:first-child,.pulse-item:nth-child(2){border-top:0}
    .timeline{grid-template-columns:repeat(2,minmax(0,1fr))}
    .timeline-item:nth-child(3){border-left:0;border-top:1px solid var(--line);padding-left:0}
    .timeline-item:nth-child(4){border-top:1px solid var(--line)}
  }
  @media(max-width:900px){
    .brief-story{display:block}
    .story-meta{flex-direction:row;flex-wrap:wrap;gap:4px 10px;margin-bottom:7px}
    .story-thumb{width:124px;aspect-ratio:300/190;float:right;margin:4px 0 8px 14px}
    .brief{display:block}
    .home-head>div{grid-column:1 / -1}
  }
  @media(max-width:650px){
    .home-head{padding-top:24px}
    .brief{margin-top:22px}
    /* One step down on a phone. At 18px the brief ran ~35 characters a line over ten
       lines; a step lifts the measure toward the low 40s and takes several lines off
       every dek on the page. Desktop was too long, mobile was too short: same fix,
       opposite direction. */
    .brief-copy{font-size:var(--fs-small);line-height:1.55}
    .story-summary{font-size:var(--fs-meta);line-height:1.5}
    .news{margin-top:38px}
    .brief-story{padding:17px 0}
    .brief-story h3{font-size:var(--fs-h3);line-height:1.32}
    .context-btn{width:44px;min-height:44px}
    /* The filter wrapped to four rows, about 330px of furniture between the reader and
       the headlines. One scrolling row with the selected chip brought into view costs
       roughly 60px instead. */
    .filters{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-padding-left:2px}
    .filters::-webkit-scrollbar{display:none}
    .filter{flex:0 0 auto}
    .show-more{min-height:44px}
    .story-thumb{width:124px;height:83px;margin:3px 0 8px 12px}
    .market-row{grid-template-columns:minmax(0,1fr) auto;gap:4px 14px}
    .market-row .market-compare{grid-column:1 / -1}
    .market-row .market-date{grid-column:2;justify-self:end;margin-top:2px}
    .market-compare,.pulse-move{min-height:0}
    .timeline{grid-template-columns:1fr}
    .timeline-item,.timeline-item+.timeline-item,.timeline-item:nth-child(3),.timeline-item:nth-child(4){padding:14px 0 15px;border-left:0;border-top:1px solid var(--line)}
    .timeline-item:first-child{border-top:0}
  }
</style>

{% macro storyCard(story, isAll=false, inFive=false) %}
{% set topicHref = story.topicUrl if story.topicUrl else ('/us-mexico.html' if story.topic == 'us-mexico' else '/' + story.topic + '.html') %}
{% set hasContext = (not isAll) and story.analysisV >= 7 and story.bg and story.view and story.prediction %}
{% set contextId = 'story-context-' + story.id %}
<article class="brief-story{% if isAll %} all-story{% endif %}"{% if isAll %} data-topic="{{ story.topic }}"{% if inFive %} data-five="y"{% endif %}{% endif %}>
  <div class="story-meta"><span class="js-storydate" data-date="{{ story.date }}">{{ story.date }}</span><a class="story-topic{% if isAll %} sec-{{ story.topic }}{% endif %}" href="{{ topicHref }}">{{ story.topicLabel if isAll else story.beat }}</a>{% if story.source %}<span class="story-outlet">{{ story.source }}</span>{% endif %}{% if story.sourceCount > 1 %}<span class="story-outlet">{{ story.sourceCount }} reports</span>{% endif %}</div>
  <div class="story-title-row">
    <div class="story-copy"><a class="story-link" href="{{ story.url }}" target="_blank" rel="noopener"><h3>{{ story.title }}</h3></a>{% if story.summary %}<p class="story-summary">{{ story.summary }}</p>{% endif %}{% if hasContext %}<button class="context-btn" type="button" aria-expanded="false" aria-controls="{{ contextId }}" aria-label="Briefly explained: {{ story.title }}" title="Briefly explained">BE</button>{% endif %}</div>
  </div>
  {% if story.image and not isAll %}<a class="story-thumb" href="{{ story.url }}" target="_blank" rel="noopener" title="Image: {{ story.source }}" aria-hidden="true" tabindex="-1"><img src="{{ story.image }}" alt="" width="300" height="190" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></a>{% endif %}
  {% if hasContext %}<div class="story-context" id="{{ contextId }}" hidden><p><span class="context-label">Background</span>{{ story.bg }}</p><p><span class="context-label">Our view</span>{{ story.view }}</p><p><span class="context-label">What we’re watching</span>{{ story.prediction }}</p>{% if story.sources.length %}<div class="coverage"><span>Sources:</span><div class="coverage-links">{% for source in story.sources %}<a href="{{ source.url }}" target="_blank" rel="noopener">{{ source.source or 'Source' }} ↗</a>{% endfor %}</div></div>{% endif %}</div>{% endif %}
</article>
{% endmacro %}

<div class="home" data-editorial-date="{{ dailyBrief.editorialDate }}">
  <header class="home-head">
    <div><h1 class="home-date" id="today">{{ dailyBrief.editorialDate }}</h1><p class="home-strap">Mexico’s economic, political, security and business news, all in one place.</p></div>
  </header>

  <section class="brief" id="brief" aria-labelledby="brief-title">
    <div class="section-top"><h2 class="kicker" id="brief-title">The brief</h2><div class="asof" id="brief-asof" data-date="{{ dailyBrief.newsThrough }}" data-prefix="{{ 'Latest brief ·' if dailyBrief.carryingLastBrief else 'Updated' }}">{{ 'Latest brief ·' if dailyBrief.carryingLastBrief else 'Updated' }} {{ dailyBrief.newsThrough }}</div></div>
    <p class="brief-copy">{{ dailyBrief.summaryLead }}</p>
    {% if homeEditorial and homeEditorial.myRead %}<div class="my-read"><p><strong>{{ homeEditorial.myRead.label or 'My read' }}:</strong> {{ homeEditorial.myRead.text }}</p><div class="read-evidence">{% for item in homeEditorial.myRead.numbers %}<a class="read-number" href="{{ item.href }}"><span>{{ item.label }}</span><b>{{ item.display }}{% if item.unit %} {{ item.unit }}{% endif %}</b><span>{{ item.observed }}</span></a>{% endfor %}<a class="read-story" href="{{ homeEditorial.myRead.storyUrl }}" target="_blank" rel="noopener">Related: {{ homeEditorial.myRead.storyLabel }} ↗</a></div></div>{% endif %}
    {% if homeEditorial and homeEditorial.sourceState %}<div class="source-state"><strong>Sources disagree:</strong> {{ homeEditorial.sourceState.note }}{% for source in homeEditorial.sourceState.sources %}<a href="{{ source.url }}" target="_blank" rel="noopener">{{ source.label }} ↗</a>{% endfor %}</div>{% endif %}
    {% if dailyBrief.briefSources.length %}<div class="brief-sources"><span>Sources:</span>{% for item in dailyBrief.briefSources %}<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.source }} ↗</a>{% endfor %}</div>{% endif %}
  </section>

  <section class="pulse" aria-labelledby="pulse-title">
    <div class="section-top"><div><h2 class="section-title" id="pulse-title">Today</h2>{% if boards.todayVintage %}<div class="pulse-asof">{{ boards.todayVintage.label }}</div>{% endif %}</div></div>
    <div class="pulse-grid" id="pulse-grid">
      {% for item in boards.today %}<article class="pulse-item"><a class="pulse-link" href="{{ item.href }}" aria-label="{{ item.label }} · {{ item.actionLabel }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}><div class="pulse-name">{{ item.label }}</div><div class="pulse-value">{{ item.display }}{% if item.unit %} <span class="pulse-unit">{{ item.unit }}</span>{% endif %}</div><div class="pulse-move">{{ item.delta if item.delta else item.move }}</div>{% if item.olderThanBlock %}<div class="pulse-date">{{ item.observed }}</div>{% endif %}</a></article>{% endfor %}
    </div>
  </section>

  <section class="news" aria-labelledby="news-title">
    <div class="section-top"><div><h2 class="section-title" id="news-title">Key developments</h2></div><span class="section-note">{{ dailyBrief.windowLabel }} · <span class="be-key"><b>BE</b> Briefly explained</span></span></div>
    <div class="story-list major-list">
      {% for story in dailyBrief.stories %}{{ storyCard(story) }}{% else %}<p class="empty">No major stories have cleared the brief yet.</p>{% endfor %}
    </div>

    {% if weeklyTop.groups.length %}<details class="all-news" id="all-news" open>
      <summary>The week <span class="week-span">{{ weeklyTop.weekLabel }}</span></summary>
      <div class="all-news-body">
        <nav class="filters" aria-label="Filter headlines by section">
          <button class="filter active" type="button" data-topic="all" aria-pressed="true">All</button>
          {%- for group in weeklyTop.groups %}
          <button class="filter" type="button" data-topic="{{ group.key }}" aria-pressed="false">{{ group.label }}</button>
          {%- endfor %}
        </nav>
        <div class="story-list" id="all-news-list">
          {%- for group in weeklyTop.groups %}{% for story in group.items %}{% if not story.shownToday %}{{ storyCard(story, true, story.inFive) }}{% endif %}{% endfor %}{% endfor %}
        </div>
        <p class="empty" id="news-empty" hidden>Nothing from this section in the last seven days.</p>
        <button class="show-more" id="news-more" type="button" hidden>Show more</button>
      </div>
    </details>{% endif %}
  </section>

  <section class="markets" aria-labelledby="markets-title">
    <div class="section-top"><div><h2 class="section-title" id="markets-title">The economy</h2></div><a class="text-link" href="/chart.html">Compare the numbers →</a></div>
    <div class="market-rows" id="market-grid">
      {% for item in boards.economy %}<a class="market-row" href="{{ item.href }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}><span class="market-name">{{ item.label }}</span><span class="market-figure"><span class="market-value">{{ item.display }}</span>{% if item.unit %}<span class="market-unit">{{ item.unit }}</span>{% endif %}</span><span class="market-compare">{{ item.compare }}</span><span class="market-date">{{ item.observed }}</span></a>{% endfor %}
    </div>
    <p class="market-note">Banco de México · INEGI</p>
  </section>

  <section class="week" aria-labelledby="week-title">
    <div class="section-top"><div><h2 class="section-title" id="week-title">Coming up</h2></div><span class="section-note">Known next</span></div>
    <div class="timeline">
      {% for event in calendar %}<article class="timeline-item">{% if not event.repeatsDate %}<div class="timeline-date">{% if event.approx %}Week of <span class="js-date" data-date="{{ event.date }}">{{ event.date }}</span>{% else %}<span class="js-caldate" data-date="{{ event.date }}">{{ event.date }}</span>{% endif %}</div><div class="timeline-rel js-rel" data-date="{{ event.date }}" data-approx="{{ 'y' if event.approx else '' }}"></div>{% endif %}<div class="timeline-title">{{ event.title }}</div>{% if event.why %}<div class="timeline-why">{{ event.why }}</div>{% endif %}{% if event.sourceUrl %}<a class="timeline-source" href="{{ event.sourceUrl }}" target="_blank" rel="noopener">{{ event.source }} ↗</a>{% else %}<div class="timeline-source">{{ event.source }}</div>{% endif %}</article>{% endfor %}
    </div>
  </section>

  <section class="subscribe-section" aria-labelledby="subscribe-title">
    <div class="sub"><h2 class="kicker" id="subscribe-title">Weekly email</h2><p class="line">Once a week, I send the few things that changed in Mexico that I think are worth knowing. The original sources are there if you want to go deeper. <a href="/weekly.html">See an example →</a></p><form class="subform" method="post" action="/api/subscribe" novalidate><input type="email" name="email" placeholder="you@email.com" aria-label="Email address" autocomplete="email" inputmode="email" required /><label class="hp-field" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label><button type="submit">Subscribe</button></form><div class="fine submsg" aria-live="polite">One email a week. Unsubscribe whenever you want.</div></div>
  </section>
</div>

<script type="module">
const editorialDate=document.querySelector('.home')?.dataset.editorialDate||'';
const date=(iso,year=false)=>{if(!iso)return'';const d=new Date(/^\d{4}-\d{2}-\d{2}$/.test(iso)?iso+'T12:00:00Z':iso);return isNaN(d)?iso:d.toLocaleDateString('en-US',{timeZone:'America/Mexico_City',month:'short',day:'numeric',...(year?{year:'numeric'}:{})});};

function closeContext(except,restoreFocus=false){
  document.querySelectorAll('.context-btn[aria-expanded="true"]').forEach((button)=>{
    if(button===except)return;
    const panel=button.closest('.brief-story')?.querySelector(':scope > .story-context');
    const focusWasInside=panel?.contains(document.activeElement);
    button.setAttribute('aria-expanded','false');
    if(panel)panel.hidden=true;
    if(restoreFocus&&focusWasInside)button.focus();
  });
}
document.querySelectorAll('.context-btn').forEach((button)=>{
  const panel=button.closest('.brief-story')?.querySelector(':scope > .story-context');
  if(!panel)return;
  button.addEventListener('click',(event)=>{event.stopPropagation();const open=button.getAttribute('aria-expanded')==='true';closeContext(open?null:button);button.setAttribute('aria-expanded',String(!open));panel.hidden=open;});
});
document.addEventListener('pointerdown',(event)=>{if(!event.target.closest?.('.context-btn,.story-context'))closeContext(null);});
document.addEventListener('keydown',(event)=>{if(event.key==='Escape')closeContext(null,true);});

const newsFilters=[...document.querySelectorAll('.filter')];
const allStories=[...document.querySelectorAll('.all-story')];
const newsEmpty=document.getElementById('news-empty');
const newsMore=document.getElementById('news-more');
const NEWS_LIMIT=4;
const FILTER_KEY='mexico-brief-headline-filter';
let newsTopic='all',newsExpanded=false;
function matchesTopic(story){if(newsTopic==='all')return story.dataset.five==='y';return story.dataset.topic===newsTopic;}
function renderNews(){
  newsFilters.forEach((button)=>{const active=button.dataset.topic===newsTopic;button.classList.toggle('active',active);button.setAttribute('aria-pressed',String(active));});
  let matched=0,shown=0;
  const limit=newsTopic==='all'?Infinity:NEWS_LIMIT;
  allStories.forEach((story)=>{const match=matchesTopic(story);if(!match){story.hidden=true;return;}matched++;const within=newsExpanded||shown<limit;story.hidden=!within;if(within)shown++;});
  if(newsEmpty)newsEmpty.hidden=matched>0;
  if(newsMore){const rest=matched-Math.min(matched,limit);newsMore.hidden=newsExpanded||rest<=0;newsMore.textContent='Show '+rest+' more';}
}
function showNews(topic,push=false){
  newsTopic=topic;newsExpanded=false;renderNews();
  try{localStorage.setItem(FILTER_KEY,topic);}catch{}
  if(push){const url=new URL(location.href);if(topic==='all')url.searchParams.delete('topic');else url.searchParams.set('topic',topic);url.hash='all-news';history.replaceState({},'',url);}
}
newsFilters.forEach((button)=>button.addEventListener('click',()=>showNews(button.dataset.topic,true)));
if(newsMore)newsMore.addEventListener('click',()=>{newsExpanded=true;renderNews();});
let initialTopic=new URLSearchParams(location.search).get('topic');
if(!initialTopic){try{initialTopic=localStorage.getItem(FILTER_KEY);}catch{}}
if(!newsFilters.some((button)=>button.dataset.topic===initialTopic))initialTopic='all';
showNews(initialTopic);
// On a phone the chips are one scrolling row, so the active one has to be brought into
// view or the reader cannot tell what is selected.
const activeChip=newsFilters.find((button)=>button.classList.contains('active'));
if(activeChip&&activeChip.scrollIntoView)activeChip.scrollIntoView({block:'nearest',inline:'center'});

const headerDay=new Date((editorialDate||new Date().toISOString().slice(0,10))+'T12:00:00Z');
document.getElementById('today').textContent=headerDay.toLocaleDateString('en-US',{timeZone:'America/Mexico_City',weekday:'long',month:'long',day:'numeric',year:'numeric'});
document.querySelectorAll('.js-date').forEach((element)=>{element.textContent=date(element.dataset.date);});
document.querySelectorAll('.js-storydate').forEach((element)=>{
  if(element.dataset.date===editorialDate){element.textContent='Today';return;}
  const storyDay=new Date(element.dataset.date+'T12:00:00Z');
  const priorDay=new Date((editorialDate||new Date().toISOString().slice(0,10))+'T12:00:00Z');priorDay.setUTCDate(priorDay.getUTCDate()-1);
  element.textContent=!isNaN(storyDay)&&storyDay.toISOString().slice(0,10)===priorDay.toISOString().slice(0,10)?'Yesterday':date(element.dataset.date);
});
const calDate=(iso)=>{const d=new Date(iso+'T12:00:00Z');return isNaN(d)?iso:d.toLocaleDateString('en-US',{timeZone:'America/Mexico_City',month:'short',day:'numeric'});};
document.querySelectorAll('.js-caldate').forEach((element)=>{element.textContent=calDate(element.dataset.date);});
const weekStart=(d)=>{const x=new Date(d.getTime());x.setUTCHours(0,0,0,0);x.setUTCDate(x.getUTCDate()-((x.getUTCDay()+6)%7));return x;};
const relDay=(iso,approx)=>{const d=new Date(iso+'T00:00:00Z'),t=new Date(editorialDate+'T00:00:00Z');if(isNaN(d)||isNaN(t))return'';const n=Math.round((d-t)/864e5);if(n<0)return'';if(approx){const w=Math.round((weekStart(d)-weekStart(t))/(7*864e5));return w<=0?'this week':w===1?'next week':'in '+w+' weeks';}if(n===0)return'today';if(n===1)return'tomorrow';return'in '+n+' days';};
document.querySelectorAll('.js-rel').forEach((element)=>{element.textContent=relDay(element.dataset.date,element.dataset.approx==='y');});
const asof=document.getElementById('brief-asof');if(asof){const d=new Date(asof.dataset.date);const prefix=asof.dataset.prefix||'Updated';asof.textContent=isNaN(d)?'':`${prefix} ${d.toLocaleDateString('en-US',{timeZone:'America/Mexico_City',month:'short',day:'numeric'})} · ${d.toLocaleTimeString('en-US',{timeZone:'America/Mexico_City',hour:'numeric',minute:'2-digit'})}`;}

document.querySelectorAll('.story-thumb img').forEach((image)=>{const remove=()=>image.closest('.story-thumb')?.remove();if(image.complete&&image.naturalWidth===0)remove();else image.addEventListener('error',remove,{once:true});});
</script>
