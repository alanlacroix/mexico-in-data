---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
locales: ["en", "es"]
permalink: "{% if locale == 'es' %}/es/{% else %}/{% endif %}"
eleventyComputed:
  title: "{% if locale == 'es' %}The Mexico Brief · Información empresarial conectada y explicada{% else %}The Mexico Brief · Mexico business news, connected and explained{% endif %}"
  description: "{% if locale == 'es' %}Hasta tres acontecimientos empresariales importantes en México, explicados en cinco minutos y vinculados a sus fuentes.{% else %}Up to three material Mexico business developments, explained in five minutes and linked to their sources.{% endif %}"
  ogTitle: "{% if locale == 'es' %}The Mexico Brief · en español{% else %}The Mexico Brief{% endif %}"
  ogDescription: "{% if locale == 'es' %}La información empresarial que importa en México. Conectada y explicada.{% else %}The business news that matters in Mexico. Connected and explained.{% endif %}"
  articleHeadline: "{% if locale == 'es' %}Informe ejecutivo sobre México{% else %}Executive briefing on Mexico{% endif %}"
articleType: NewsArticle
bodyClass: brief-page
---
{% set f = feedEs if locale == 'es' else feed %}
{% set editionUrl = '/es/editions/' + f.date + '/' if locale == 'es' else '/editions/' + f.date + '/' %}
{% set archiveUrl = '/es/editions/' if locale == 'es' else '/editions/' %}

<article class="edition" aria-labelledby="edition-title" data-artifact-hash="{{ f.artifactHash }}">
  <header class="edition-header">
    <h1 id="edition-title" class="visually-hidden">{% if locale == 'es' %}Informe de negocios en México{% else %}Mexico business briefing{% endif %}</h1>
    <div class="edition-meta{% if f.weeklyBrief %} weekly-edition-meta{% endif %}" aria-label="{% if locale == 'es' %}Datos de la edición{% else %}Edition details{% endif %}">
      {% if f.weeklyBrief %}<a class="edition-date" href="{{ editionUrl }}"><time datetime="{{ f.weeklyBrief.through }}">{{ f.weeklyBrief.start | weekRange(f.weeklyBrief.through, locale) }}</time></a><span aria-hidden="true">·</span>
      {% else %}<a class="edition-date" href="{{ editionUrl }}">{{ f.date | longDate(locale) }}</a><span aria-hidden="true">/</span>{% endif %}
      {% for archived in archiveEditions %}{% if archived.locale == locale and archived.edition.editorialDate == f.date %}<span>{{ archived.minutes }} {% if locale == 'es' %}min de lectura{% else %}min read{% endif %}</span><span aria-hidden="true">/</span>{% endif %}{% endfor %}
      <time{% if f.weeklyBrief %} class="weekly-published visually-hidden"{% endif %} datetime="{{ f.updated }}" data-published-at="{{ f.updated }}">{% if locale == 'es' %}Publicada {{ f.updated }}{% else %}Published {{ f.updated }}{% endif %}</time>
    </div>
    <div class="freshness-alert" id="freshness-alert" role="status"{% if not f.carrying %} hidden{% endif %}>
      {% if locale == 'es' %}Aún no hay una edición más reciente.{% else %}A newer edition is not yet available.{% endif %}
    </div>
  </header>

  {% if f.weeklyBrief %}
  {% set weeklyBrief = f.weeklyBrief %}
  {% include "partials/weekly-brief.njk" %}
  {% else %}
  <section class="developments" aria-label="{% if locale == 'es' %}Noticias{% else %}Stories{% endif %}" data-edition-stories>
    {% for story in f.stories %}{% include "partials/brief-story.njk" %}{% endfor %}
  </section>
  {% endif %}

</article>

<script>
(function () {
  var published = document.querySelector('[data-published-at]');
  var alertBox = document.getElementById('freshness-alert');
  if (!published || !alertBox) return;
  var publishedAt = new Date(published.getAttribute('data-published-at'));
  if (!Number.isNaN(publishedAt.getTime())) {
    published.textContent = {% if locale == 'es' %}'Publicada '{% else %}'Published '{% endif %} + new Intl.DateTimeFormat(
      {% if locale == 'es' %}'es-MX'{% else %}'en-US'{% endif %}, { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Mexico_City' }
    ).format(publishedAt) + ' CT';
  }
  {% if f.weeklyBrief %}
  var through = new Date({{ f.weeklyBrief.through | dump | safe }} + 'T23:59:59-06:00');
  alertBox.hidden = Date.now() - through.getTime() < 7 * 86400000;
  return;
  {% endif %}
  var parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Mexico_City', year: 'numeric', month: '2-digit', day: '2-digit',
    weekday: 'short', hour: '2-digit', hourCycle: 'h23'
  }).formatToParts(new Date()).reduce(function (out, part) { out[part.type] = part.value; return out; }, {});
  var current = new Date(Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day)));
  var weekday = current.getUTCDay();
  var daysBack = 0;
  if (weekday === 0) daysBack = 2;
  else if (weekday === 6) daysBack = 1;
  else if (Number(parts.hour) < 7) daysBack = weekday === 1 ? 3 : 1;
  current.setUTCDate(current.getUTCDate() - daysBack);
  alertBox.hidden = {{ f.date | dump | safe }} >= current.toISOString().slice(0, 10);
})();
</script>
