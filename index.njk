---
layout: base.njk
permalink: /
title: "The Mexico Brief"
description: "Mexico’s economic, political, security and business news, all in one place."
ogTitle: "The Mexico Brief"
ogDescription: "Mexico’s economic, political, security and business news, all in one place."
bodyClass: feed-page
footerBlurb: "Mexico’s economic, political, security and business news, all in one place."
---
{#- The feed, built to the design handoff of 2026-08-02.

    Two rules from that handoff that are easy to break by accident:
    1. There are no media queries. One layout reflows, driven by auto-fit + minmax().
       Any minmax floor above ~300px is wrapped in min(Xpx, 100%), or the page scrolls
       sideways on a phone with the text clipped off the right edge.
    2. Every count, label and chip is derived from the data. Nothing here is hardcoded to
       today's two stories or five numbers, and a block with no items does not render at
       all rather than printing a heading over nothing. -#}
<style>
  .feed [hidden]{display:none!important}
  .feed{max-width:1120px;margin:0 auto;padding:0 20px}
  .feed-sec{padding-bottom:46px}
  .sec-rule{border-top:2px solid #0B6E4F}
  .sec-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 20px;padding:14px 0 18px}
  .sec-head h2{font-family:var(--sans);font-weight:800;font-size:32px;line-height:1;letter-spacing:-.025em;color:#111214;margin:0}
  .sec-meta{font-family:var(--mono);font-weight:400;font-size:11px;line-height:1;letter-spacing:.1em;text-transform:uppercase;color:#86888E}
  .sec-meta a{color:#0B6E4F;font-weight:500;font-size:12px}

  .dateline{padding:32px 0 0}
  .dateline h1{font-family:var(--sans);font-weight:600;font-size:30px;line-height:1.05;letter-spacing:-.015em;text-transform:none;color:#111214;margin:0}

  .brief-p{font-family:var(--serif);font-weight:400;font-size:20px;line-height:1.55;color:#1A1B1D;max-width:62ch;text-wrap:pretty}
  .brief-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:20px}
  .brief-src{font-family:var(--mono);font-size:12px;color:#86888E;display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center}
  .brief-src a{color:#0B6E4F}

  .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(166px,1fr));gap:1px;background:#E2E2E2;border:1px solid #E2E2E2}
  .tile-cell{background:#fff;display:flex;flex-direction:column}
  .tile{background:#fff;padding:14px 14px 12px;display:flex;flex-direction:column;gap:9px;text-align:left;border:0;cursor:pointer;font:inherit;width:100%}
  .tile:hover{background:#F7F7F7}
  .tile-top{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
  .tile-label{font-family:var(--mono);font-weight:500;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#5C5E63}
  .tile-date{font-family:var(--mono);font-size:11px;color:#B0B2B8;white-space:nowrap}
  .tile-val{display:flex;align-items:baseline;gap:5px;flex-wrap:wrap}
  .tile-val b{font-family:var(--sans);font-weight:700;font-size:27px;letter-spacing:-.03em;color:#111214}
  .tile-unit{font-family:var(--mono);font-size:10px;color:#86888E}
  .tile-change{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
  .tile-delta{font-family:var(--mono);font-weight:500;font-size:12px;color:#1A1B1D;white-space:nowrap}
  .verdict{font-family:var(--mono);font-weight:600;font-size:9.5px;letter-spacing:.09em;padding:4px 6px;border-radius:2px;white-space:nowrap}
  .m-good{background:#EAF3EF;color:#0B6E4F}
  .m-bad{background:#FAEEEC;color:#B4483A}
  .m-flat{background:#F1F1F1;color:#6B6D73}
  .tile-more{text-align:right;font-family:var(--mono);font-weight:500;font-size:9.5px;letter-spacing:.09em;color:#86888E}
  .tile-why{border-top:1px solid #EBEBEB;margin:0 14px 12px;padding-top:10px;font-family:var(--serif);font-size:15px;line-height:1.45;color:#3C3D40;animation:panel .28s ease}

  .cards{display:grid;grid-template-columns:1fr;border-bottom:1px solid #E2E2E2}
  .cards-wk{grid-template-columns:1fr}
  .card{border-top:1px solid #E2E2E2;padding:20px 0;display:flex;flex-direction:column;gap:12px}
  .card-wk{padding:18px 0}
  .card-meta{display:flex;flex-wrap:wrap;align-items:center;gap:10px;font-family:var(--mono);font-weight:500;font-size:11px;letter-spacing:.06em}
  .card-meta .d{color:#5C5E63}
  .card-meta .c{color:#1A1B1D;display:inline-flex;align-items:center;gap:6px}
  .dot{width:7px;height:7px;border-radius:999px;flex:none}
  .card-meta .s{color:#86888E}
  .es{border:1px solid #D9D9DB;border-radius:2px;padding:2px 5px;font-size:9px;color:#96989E;font-style:normal}
  .card h3{font-family:var(--sans);font-weight:700;font-size:25px;line-height:1.14;letter-spacing:-.02em;color:#111214;margin:0;max-width:32ch;text-wrap:pretty}
  .card-wk h3{font-size:20px;line-height:1.2;letter-spacing:-.015em;max-width:40ch}
  .card h3 a{color:inherit}
  .card h3 a:hover{color:#0B6E4F;text-decoration:none}
  .orig{font-family:var(--mono);font-size:12px;line-height:1.4;color:#96989E;max-width:58ch;text-wrap:pretty}
  .dek{font-family:var(--sans);font-size:16px;line-height:1.5;color:#5C5E63;max-width:58ch;text-wrap:pretty}
  .card-wk .dek{font-size:15px}

  .be-btn{display:inline-flex;align-items:center;gap:9px;align-self:flex-start;background:transparent;border:1px solid #D4D4D6;border-radius:2px;padding:6px 11px 6px 6px;cursor:pointer;font:inherit}
  .be-btn:hover{border-color:#0B6E4F}
  .be-badge{display:inline-flex;align-items:center;justify-content:center;width:22px;height:20px;background:#0B6E4F;color:#fff;font-family:var(--mono);font-weight:600;font-size:10px;letter-spacing:.04em}
  .card-wk .be-badge{width:21px;height:19px}
  .be-label{font-family:var(--mono);font-weight:500;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#1A1B1D}
  .be-panel{border-left:2px solid #0B6E4F;padding:2px 0 2px 16px;display:grid;gap:14px;animation:panel .28s ease}
  .card-wk .be-panel{padding-left:14px}
  .be-part>span{display:block;margin-bottom:6px}
  .lb-why{font-family:var(--mono);font-weight:500;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#0B6E4F}
  .lb-watch{font-family:var(--mono);font-weight:500;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#86888E}
  .lb-src{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#86888E}
  .bd-why{font-family:var(--serif);font-size:18px;line-height:1.5;color:#1A1B1D;max-width:58ch;text-wrap:pretty}
  .card-wk .bd-why{max-width:56ch}
  .bd-watch{font-family:var(--serif);font-size:16px;line-height:1.5;color:#3C3D40;max-width:58ch;text-wrap:pretty}
  .bd-src a{color:#0B6E4F;font-family:var(--mono);font-size:12px}

  .chips{display:flex;flex-wrap:wrap;gap:7px;padding-bottom:18px}
  .chip{border:1px solid #E2E2E2;border-radius:999px;padding:7px 13px;background:#fff;color:#1A1B1D;font-family:var(--mono);font-weight:500;font-size:12px;cursor:pointer}
  .chip span{opacity:.55;margin-left:5px}
  .chip:hover{border-color:#0B6E4F}
  .chip.on{background:#111214;color:#fff;border-color:#111214}
  .more{display:block;width:100%;margin-top:18px;background:#F5F5F5;border:1px solid #E2E2E2;padding:13px;font-family:var(--mono);font-weight:500;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#1A1B1D;cursor:pointer}
  .more:hover{background:#EBEBEB;color:#0B6E4F}

  .cal{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:26px}
  .cal-g{display:flex;gap:14px}
  .cal-rail{flex:0 0 74px;border-top:2px solid #111214;padding-top:9px}
  .cal-g.soon .cal-rail{border-top-color:#0B6E4F}
  .cal-when{font-family:var(--mono);font-weight:600;font-size:14px;color:#111214}
  .cal-rel{font-family:var(--mono);font-size:11px;color:#96989E;margin-top:2px}
  .cal-g.soon .cal-rel{color:#0B6E4F}
  .cal-body{flex:1;border-top:1px solid #E2E2E2;padding-top:9px;display:grid;gap:20px;min-width:0}
  .cal-t{font-family:var(--sans);font-weight:600;font-size:17px;line-height:1.25;color:#111214;text-wrap:pretty}
  .cal-w{font-family:var(--sans);font-size:14px;line-height:1.45;color:#5C5E63;margin-top:4px;text-wrap:pretty}
  .cal-why{font-family:var(--serif);font-size:15px;line-height:1.5;color:#1A1B1D;margin-top:6px;text-wrap:pretty}
  .cal-s{font-family:var(--mono);font-size:11px;color:#96989E;margin-top:6px;display:block}
  .cal-s a{color:inherit}

  .econ{border-top:1px solid #E2E2E2}
  .econ-row{border-bottom:1px solid #E2E2E2;padding:18px 0;display:grid;gap:13px}
  .econ-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 16px}
  .econ-name{font-family:var(--mono);font-weight:600;font-size:14px;letter-spacing:.02em;color:#111214}
  .econ-period{font-family:var(--mono);font-size:11px;color:#96989E;margin-top:4px}
  .econ-val{display:flex;align-items:baseline;gap:5px}
  .econ-val b{font-family:var(--sans);font-weight:700;font-size:30px;letter-spacing:-.03em;color:#111214}
  .econ-unit{font-family:var(--mono);font-size:10px;color:#86888E}
  .bars{display:grid;gap:5px}
  .bar{display:grid;grid-template-columns:88px minmax(0,1fr) auto;gap:10px;align-items:center}
  .bar-l{font-family:var(--mono);font-weight:500;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:#111214}
  .bar-l.ref{font-weight:400;color:#86888E}
  .track{height:10px;background:#F0F0F0;display:block}
  .fill{height:100%;background:#111214;display:block}
  .fill.ref{background:#D4D4D6}
  .bar-v{font-family:var(--mono);font-weight:500;font-size:11px;color:#111214;white-space:nowrap}
  .bar-v.ref{font-weight:400;color:#5C5E63}
  .econ-note{font-family:var(--serif);font-size:16px;line-height:1.5;color:#1A1B1D;max-width:62ch;text-wrap:pretty}
  .econ-src{font-family:var(--mono);font-size:11px;color:#96989E;margin-top:12px}

  .mail{background:#111214;padding:26px 22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px;align-items:center}
  .mail-k{font-family:var(--mono);font-weight:500;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#16A06C}
  .mail-c{font-family:var(--serif);font-size:20px;line-height:1.4;color:#F2F2F2;max-width:34ch;margin-top:10px}
  .mail-c a{color:#16A06C}
  .mail-f{display:flex;flex-wrap:wrap;gap:10px}
  .mail-f input{flex:1 1 190px;background:#1B1C1E;border:1px solid #313337;color:#fff;padding:13px 14px;font-family:var(--sans);font-size:15px}
  .mail-f button{background:#0B6E4F;color:#fff;border:0;padding:13px 22px;font-family:var(--mono);font-weight:600;font-size:12px;letter-spacing:.12em;cursor:pointer}
  .mail-f button:hover{background:#16A06C}
  .mail-fine{font-family:var(--mono);font-size:11px;line-height:1.5;color:#7A7C82;margin-top:9px}

  @keyframes panel{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
  @keyframes draw{to{stroke-dashoffset:0}}
  .spark{width:100%;height:24px;display:block}
  .spark polyline{stroke-dasharray:240;stroke-dashoffset:240;animation:draw 1.2s ease forwards}
  @media(prefers-reduced-motion:reduce){
    .spark polyline{animation:none;stroke-dashoffset:0}
    .tile-why,.be-panel{animation:none}
  }
</style>

<div class="feed">
  <div class="dateline"><h1>{{ feed.date | longDate }}</h1></div>
  <section class="feed-sec" id="sec-brief" data-sec="The brief">
    <div class="sec-rule"></div>
    <div class="sec-head"><h2>The brief</h2><div class="sec-meta" id="brief-asof" data-date="{{ feed.updated }}" data-prefix="{{ 'Latest brief' if feed.carrying else 'Updated' }}">{{ 'Latest brief' if feed.carrying else 'Updated' }}</div></div>
    <p class="brief-p">{{ feed.brief }}</p>
    <div class="brief-row">
      {%- if feed.briefSources.length %}<div class="brief-src"><span>Sources</span>{% for item in feed.briefSources %}<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.source }} ↗</a>{% endfor %}</div>{% endif %}
    </div>
  </section>

  {% if feed.numbers.length %}<section class="feed-sec" id="sec-numbers" data-sec="What moved">
    <div class="sec-rule"></div>
    <div class="sec-head"><h2>What moved since the day before</h2><div class="sec-meta">Line: 30 days</div></div>
    <div class="tiles">
      {%- for n in feed.numbers %}
      <div class="tile-cell">
        <button class="tile" type="button" aria-expanded="false" aria-controls="why-{{ n.id }}" data-toggle="why-{{ n.id }}">
          <span class="tile-top"><span class="tile-label">{{ n.label }}</span><span class="tile-date">{{ n.asOf }}</span></span>
          <span class="tile-val"><b>{{ n.value }}</b>{% if n.unit %}<span class="tile-unit">{{ n.unit }}</span>{% endif %}</span>
          <span class="tile-change"><span class="tile-delta">{{ n.delta }}</span><span class="verdict m-{{ n.mood }}">{{ n.tag }}</span></span>
          {%- if n.points %}<svg class="spark" viewBox="0 0 100 26" preserveAspectRatio="none" aria-hidden="true"><polyline points="{{ n.points }}" fill="none" stroke="{{ n.tone }}" stroke-width="1.5" vector-effect="non-scaling-stroke" style="animation-delay:{{ 0.15 + loop.index0 * 0.10 }}s"/></svg>{% endif %}
          {%- if n.why %}<span class="tile-more" data-more>WHY +</span>{% endif %}
        </button>
        {%- if n.why %}<div class="tile-why" id="why-{{ n.id }}" hidden>{{ n.why }}</div>{% endif %}
      </div>
      {%- endfor %}
    </div>
  </section>{% endif %}

  {% if feed.stories.length %}<section class="feed-sec" id="sec-stories" data-sec="Today's stories">
    <div class="sec-rule"></div>
    <div class="sec-head"><h2>Today’s stories</h2><div class="sec-meta">{{ feed.stories.length }} {{ 'story' if feed.stories.length == 1 else 'stories' }} today</div></div>
    <div class="cards">
      {%- for story in feed.stories %}
      <article class="card">
        <div class="card-meta"><span class="d">{{ story.date }}</span><span class="c"><i class="dot" style="background:{{ story.catKey | catColor }}"></i>{{ story.cat }}</span><span class="s">{{ story.source }}</span></div>
        <h3><a href="{{ story.url }}" target="_blank" rel="noopener">{{ story.title }}</a></h3>
        {%- if story.dek %}<p class="dek">{{ story.dek }}</p>{% endif %}
        {%- if story.why %}
        <button class="be-btn" type="button" aria-expanded="{{ 'true' if loop.first else 'false' }}" aria-controls="be-{{ story.id }}" data-toggle="be-{{ story.id }}"><span class="be-badge">BE</span><span class="be-label">{{ 'Hide' if loop.first else 'Briefly explained' }}</span></button>
        <div class="be-panel" id="be-{{ story.id }}"{% if not loop.first %} hidden{% endif %}>
          {%- if story.bg %}<div class="be-part"><span class="lb-watch">Background</span><p class="bd-watch">{{ story.bg }}</p></div>{% endif %}
          {%- if story.view %}<div class="be-part"><span class="lb-why">Our view</span><p class="bd-why">{{ story.view }}</p></div>{% endif %}
          {%- if story.watch %}<div class="be-part"><span class="lb-watch">What we’re watching</span><p class="bd-watch">{{ story.watch }}</p></div>{% endif %}
          <div class="be-part bd-src"><span class="lb-src">Source</span><a href="{{ story.url }}" target="_blank" rel="noopener">{{ story.source }} ↗</a></div>
        </div>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
  </section>{% endif %}

  {% if feed.week.length %}<section class="feed-sec" id="sec-week" data-sec="This week">
    <div class="sec-rule"></div>
    <div class="sec-head"><h2>This week</h2><div class="sec-meta">{{ feed.weekLabel }} · if you missed the week</div></div>
    <div class="chips" id="wk-chips"></div>
    <div class="cards cards-wk" id="wk-list">
      {%- for item in feed.week %}
      <article class="card card-wk" data-cat="{{ item.cat }}">
        <div class="card-meta"><span class="d">{{ item.date }}</span><span class="c"><i class="dot" style="background:{{ item.catKey | catColor }}"></i>{{ item.cat }}</span><span class="s">{{ item.source }}{% if item.lang %} <i class="es">{{ item.lang }}</i>{% endif %}</span></div>
        <h3><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a></h3>
        {%- if item.orig %}<p class="orig">{{ item.orig }}</p>{% endif %}
        {%- if item.dek %}<p class="dek">{{ item.dek }}</p>{% endif %}
        {%- if item.why %}
        <button class="be-btn" type="button" aria-expanded="false" aria-controls="bw-{{ item.id }}" data-toggle="bw-{{ item.id }}"><span class="be-badge">BE</span><span class="be-label">Briefly explained</span></button>
        <div class="be-panel" id="bw-{{ item.id }}" hidden>
          {%- if item.bg %}<div class="be-part"><span class="lb-watch">Background</span><p class="bd-watch">{{ item.bg }}</p></div>{% endif %}
          {%- if item.view %}<div class="be-part"><span class="lb-why">Our view</span><p class="bd-why">{{ item.view }}</p></div>{% endif %}
          {%- if item.watch %}<div class="be-part"><span class="lb-watch">What we’re watching</span><p class="bd-watch">{{ item.watch }}</p></div>{% endif %}
          <div class="be-part bd-src"><span class="lb-src">Source</span><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.source }} ↗</a></div>
        </div>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
    <button class="more" id="wk-more" type="button" hidden></button>
  </section>{% endif %}

  {% if feed.upcoming.length %}<section class="feed-sec" id="sec-coming" data-sec="Coming up">
    <div class="sec-rule"></div>
    <div class="sec-head"><h2>Coming up</h2><div class="sec-meta">Scheduled releases and decisions</div></div>
    <div class="cal">
      {%- for group in feed.upcoming %}
      <div class="cal-g{% if group.soon %} soon{% endif %}">
        <div class="cal-rail"><div class="cal-when">{{ group.when }}</div><div class="cal-rel">{{ group.rel }}</div></div>
        <div class="cal-body">
          {%- for event in group.items %}
          <div><div class="cal-t">{{ event.title }}</div>{% if event.what %}<div class="cal-w">{{ event.what }}</div>{% endif %}{% if event.why %}<div class="cal-why">{{ event.why }}</div>{% endif %}{% if event.url %}<span class="cal-s"><a href="{{ event.url }}" target="_blank" rel="noopener">{{ event.source }} ↗</a></span>{% else %}<span class="cal-s">{{ event.source }}</span>{% endif %}</div>
          {%- endfor %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </section>{% endif %}

  {% if feed.econ.length %}<section class="feed-sec" id="sec-econ" data-sec="The economy">
    <div class="sec-rule"></div>
    <div class="sec-head"><h2>Where the economy stands</h2><div class="sec-meta"><a href="/chart.html">Compare the numbers →</a></div></div>
    <div class="econ">
      {%- for row in feed.econ %}
      <div class="econ-row">
        <div class="econ-head">
          <div><div class="econ-name">{{ row.name }}</div><div class="econ-period">{{ row.period }}</div></div>
          <div class="econ-val"><b>{{ row.value }}</b>{% if row.unit %}<span class="econ-unit">{{ row.unit }}</span>{% endif %}</div>
        </div>
        <div class="bars">
          <div class="bar"><span class="bar-l">Now</span><span class="track"><span class="fill" style="width:{{ row.nowPct }}%"></span></span><span class="bar-v">{{ row.nowText }}</span></div>
          <div class="bar"><span class="bar-l ref">{{ row.refLabel }}</span><span class="track"><span class="fill ref" style="width:{{ row.refPct }}%"></span></span><span class="bar-v ref">{{ row.refText }}</span></div>
        </div>
        {%- if row.note %}<p class="econ-note">{{ row.note }}</p>{% endif %}
      </div>
      {%- endfor %}
    </div>
    <p class="econ-src">Banco de México · INEGI</p>
  </section>{% endif %}

  <section class="feed-sec" id="sec-mail" data-sec="Weekly email">
    <div class="mail">
      <div>
        <div class="mail-k">Weekly email</div>
        <p class="mail-c">One email a week: what changed in Mexico, why it changed, and the sources behind it. <a href="/weekly.html">See an example →</a></p>
      </div>
      <div>
        <form class="mail-f" method="post" action="/api/subscribe" novalidate>
          <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" autocomplete="email" inputmode="email" required />
          <label class="hp-field" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          <button type="submit">Subscribe</button>
        </form>
        <div class="mail-fine submsg" aria-live="polite">One email a week. Unsubscribe whenever you want.</div>
      </div>
    </div>
  </section>
</div>

<script type="module">
const $ = (sel, root = document) => root.querySelector(sel);
const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];
const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

// Every panel on the page is the same contract: a button with aria-expanded and the
// hidden element it controls.
$$('[data-toggle]').forEach((button) => {
  button.addEventListener('click', () => {
    const panel = document.getElementById(button.dataset.toggle);
    if (!panel) return;
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    panel.hidden = open;
    const label = $('.be-label', button);
    if (label) label.textContent = open ? 'Briefly explained' : 'Hide';
    const more = $('[data-more]', button);
    if (more) more.textContent = open ? 'WHY +' : 'HIDE −';
  });
});

// The freshness stamp is the one value the build cannot format: it is a clock time and
// belongs in the reader's Mexico City day. Everything else is formatted at build time.
const asof = $('#brief-asof');
if (asof) {
  const when = new Date(asof.dataset.date);
  asof.textContent = Number.isNaN(when.getTime()) ? asof.dataset.prefix
    : `${asof.dataset.prefix} ${when.toLocaleTimeString('en-US', { timeZone: 'America/Mexico_City', hour: 'numeric', minute: '2-digit' })}`;
}

// This week: chips derived from the categories actually present, with live counts.
const list = $('#wk-list'), chipRow = $('#wk-chips'), moreBtn = $('#wk-more');
if (list && chipRow && moreBtn) {
  const cards = $$('.card', list);
  const VISIBLE = 3;
  let filter = 'All', expanded = false;

  const counts = new Map();
  cards.forEach((card) => counts.set(card.dataset.cat, (counts.get(card.dataset.cat) || 0) + 1));
  chipRow.innerHTML = ['All', ...counts.keys()].map((cat) => {
    const n = cat === 'All' ? cards.length : counts.get(cat);
    return `<button class="chip${cat === 'All' ? ' on' : ''}" type="button" data-cat="${cat}">${cat}<span>${n}</span></button>`;
  }).join('');

  const render = () => {
    const matching = cards.filter((card) => filter === 'All' || card.dataset.cat === filter);
    cards.forEach((card) => { card.hidden = true; });
    const shown = expanded ? matching : matching.slice(0, VISIBLE);
    shown.forEach((card) => { card.hidden = false; });
    const rest = matching.length - shown.length;
    moreBtn.hidden = rest <= 0;
    moreBtn.textContent = `Show ${rest} more`;
    $$('.chip', chipRow).forEach((chip) => chip.classList.toggle('on', chip.dataset.cat === filter));
  };
  chipRow.addEventListener('click', (event) => {
    const chip = event.target.closest('.chip');
    if (!chip) return;
    filter = chip.dataset.cat;
    expanded = false;                       // a new filter starts from the top
    render();
  });
  moreBtn.addEventListener('click', () => { expanded = true; render(); });
  render();
}

// Section reveal. The hidden state is set from JS, never CSS, and a safety timer reveals
// everything if the observer never fires, so a failed observer cannot leave a blank page.
const sections = $$('[data-sec]');
if (!still && 'IntersectionObserver' in window) {
  const reveal = (section) => { section.style.opacity = '1'; section.style.transform = 'none'; };
  sections.forEach((section) => {
    section.style.opacity = '0';
    section.style.transform = 'translateY(16px)';
    section.style.transition = 'opacity .55s cubic-bezier(.2,.7,.3,1), transform .55s cubic-bezier(.2,.7,.3,1)';
  });
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      reveal(entry.target);
      observer.unobserve(entry.target);
    });
  }, { threshold: 0.05 });
  sections.forEach((section) => observer.observe(section));
  setTimeout(() => sections.forEach(reveal), 1400);
}
</script>
