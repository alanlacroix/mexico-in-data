  // Frozen receipts for this edition. These do not change when standing.json is refreshed.
  const fdiFact={fact:'Foreign direct investment reached US$40.9bn in 2025. Reinvested earnings were 67.7% of the total and new investment was 18.0%; new investment itself rose 132.9% from 2024. The record is real, but the total does not tell us how much new physical capacity was built.',source:'Secretaría de Economía · 2025 FDI',url:'https://www.gob.mx/se/prensa/mexico-alcanza-cifra-historica-de-inversion-extranjera-directa-en-2025-40-871-millones-de-dolares-crecio-un-10-8-anual'};
  const investmentFact={fact:'Real fixed investment was 5.1% higher than a year earlier in April 2026. That is a better reading, but one month does not establish a recovery.',source:'INEGI · Fixed investment, Apr 2026',url:'https://en.www.inegi.org.mx/app/saladeprensa/noticia/10979'};
