  return dates.map(date=>({date,value:maps.reduce((total,m)=>total+m[date],0)}));
}
function realWage(){
  const wage=monthlyLast(s('banxico-salario-minimo')), cpi=monthMap(monthlyLast(s('banxico-inpc'))), shared=wage.filter(p=>cpi[p.date.slice(0,7)]!=null);
  const base=shared[0], baseCpi=cpi[base?.date.slice(0,7)];
  return shared.map(p=>({date:p.date,value:(p.value/cpi[p.date.slice(0,7)])/(base.value/baseCpi)*100}));
