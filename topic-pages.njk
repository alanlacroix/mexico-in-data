  const line=(name,points,color,format)=>({name,points,color,format});
  const liveEx=sLive('banxico-exports-total'),liveIm=sLive('banxico-imports-total'),liveBal=sLive('banxico-trade-balance'),liveInter=sLive('banxico-imports-intermediate'),liveCapital=sLive('banxico-imports-capital');
  const liveExLast=last(liveEx)||last(ex),liveInterLast=last(liveInter)||last(inter);
  const LE=last(rolling12(liveEx,1e6))||E,LI=last(rolling12(liveIm,1e6))||I,LB=last(liveBal)||B,LM=last(rolling12(liveInter,1e6))||M,LC=last(liveCapital)||last(capital),LCY=LC?yearAgo(liveCapital.length?liveCapital:capital,LC):null;
  const fdiFact=standing('std-fdi-composition');
  return {
    title:'Trade',
    asof:`Last revised ${shortDate(new Date().toISOString().slice(0,10))}, ${new Date().getUTCFullYear()} · newest number ${dateLabel(last(ex).date)}`,
    lead:`Mexico exports a lot, but mostly to one place. It exported $${fmt(E.value,0)} billion of goods in the twelve months through ${dateLabel(E.date)}. In ${pYear}, ${fmt(us.share,1)}% of goods exports went to the United States, and vehicles, electronics and machinery made up ${fmt(leadShare,0)}% of exports. Parts and materials used by factories were ${fmt(intermediateShare,1)}% of imports over the latest twelve months. That is the model: import components, assemble them and sell the finished product north. It works, but it gives Washington a lot of leverage.<br><br>My base case is that existing factories keep shipping while some new investment waits for clearer rules on tariffs, regional content and Chinese inputs. I would turn more positive if the three governments agree to a durable extension with workable sector rules, and more negative if broad U.S. measures begin interrupting trade that currently qualifies under the United States–Mexico–Canada Agreement (USMCA). For investors and operators, an established plant inside the supply chain is easier to underwrite than a new one that needs ten years of stable rules to pay back.`,
    next:watchFor(/USMCA|tariff|trade talks/i)||'The next USMCA and tariff dates are on the calendar below.',
    readings:[
      {label:'Goods exports · trailing 12 months',value:`$${fmt(LE.value,0)}`,unit:'bn',change:`through ${dateLabel(liveExLast.date)}`,context:'Goods only. Services are not included.',source:sourceName('banxico-exports-total'),sourceHref:sourceUrl('banxico-exports-total'),date:dateLabel(liveExLast.date),href:'/chart.html?q=us-demand'},
      {label:'Exports going to the United States',value:fmt(us.share,1),unit:'%',change:String(pYear),context:'Mexico has scale in one market and unusually high exposure to one buyer.',source:'UN COMTRADE',sourceHref:'https://comtradeplus.un.org/TradeFlow/',date:String(pYear)},
      {label:'Imports used as factory inputs',value:fmt(LM.value/LI.value*100,1),unit:'%',change:'trailing 12 months',context:'Most imports are parts and materials, not finished consumer goods.',source:sourceName('banxico-imports-intermediate'),sourceHref:sourceUrl('banxico-imports-intermediate'),date:dateLabel(liveInterLast.date),href:'/chart.html?q=us-demand'},
      {label:'Monthly goods balance',value:`${LB.value>=0?'+':'-'}$${fmt(Math.abs(LB.value)/1e6,1)}`,unit:'bn',change:dateLabel(LB.date),context:'Exports minus imports for one month; it can swing sharply around zero.',source:sourceName('banxico-trade-balance'),sourceHref:sourceUrl('banxico-trade-balance'),date:dateLabel(LB.date)}
    ],
    sections:[
      {h2:`Cars, electronics and machinery are ${fmt(leadShare,0)}% of exports`,
       prose:[`Vehicles, electronics and machinery are <b>${fmt(leadShare,0)}%</b> of what Mexico sold abroad over the latest twelve months. The total came to $${fmt(E.value,0)} billion, close to $${fmt(E.value/365,1)} billion a day. Mexican exports are therefore unusually exposed to U.S. factory and vehicle demand. Other sectors matter, but they do not remove that concentration.`],
       chart:comp?{title:comp.title,stat:`$${fmt(E.value,0)}bn/yr`,visual:comp.visual,legend:comp.legend,table:comp.table,srcHtml:`<a href="https://comtradeplus.un.org/TradeFlow/" target="_blank" rel="noopener">UN COMTRADE · ${pYear} ↗</a>`,label:'Export composition treemap',css:'composition-evidence'}:null},
      {h2:`${fmt(intermediateShare,0)}% of imports are factory parts, not shopping`,
       prose:[`Most of what Mexico imports never reaches a shopper. Parts and materials bound for factories were <b>${fmt(intermediateShare,1)}%</b> of imports over the same twelve months. Exports and imports therefore rise and fall together instead of trading off. It also changes what a tariff does. A duty on imported parts raises the cost of goods Mexico has not sold yet, so it lands on exports as much as on imports.`],
       chart:{title:'Total imports and factory inputs, trailing 12 months, US$ billions',stat:`${fmt(intermediateShare,0)}% inputs`,series:[line('All imports',im12,INK,v=>'$'+fmt(v,0)+'bn'),line('Intermediate inputs',inter12,GREEN,v=>'$'+fmt(v,0)+'bn')],yFormat:v=>'$'+fmt(v,0),label:'Trailing 12-month imports and intermediate-goods imports',srcId:'banxico-imports-total',srcId2:'banxico-imports-intermediate'}},
      {h2:'Nearshoring should be judged by money already put to work',
       prose:[`${fdiFact?esc(fdiFact.fact):'Foreign-investment headlines include both new projects and money reinvested by companies already operating in Mexico.'}`,
        `${LC?`Capital-goods imports were ${LCY?fmt(Math.abs(pct(LC.value,LCY.value)),1)+'% '+(LC.value>=LCY.value?'above':'below')+' a year earlier':'$'+fmt(LC.value/1e6,1)+' billion'} in ${dateLabel(LC.date)}. `:''}Machinery imports, private construction, grid connections and formal hiring are harder evidence than a press release. If those measures do not follow an announcement, the capacity has not arrived yet.`]},
      {h2:'The US declined the 16-year extension',
       prose:[`The United States–Mexico–Canada Agreement (USMCA) remains in force. ${usmca?esc(usmca.title)+'. ':''}The United States turned down a 16-year extension, which would have settled the terms in a single round. Each review can now reopen tariffs and sector rules, the same rules the numbers above sit on. The clock runs to 2036 unless the countries agree to an extension first.`,
        `My base case is continued trade with more friction, not the disappearance of the agreement. Existing factories are difficult to unwind. The annual review matters most for projects that need many years of stable rules before they earn back their cost.`],
       chart:timelineItems.length?{title:'The next dated events on the trade calendar',visual:timeline(timelineItems),legend:'',table:timelineTable(timelineItems),srcHtml:usmca?`<a href="${usmca.url}" target="_blank" rel="noopener">USTR · USMCA review ↗</a>`:'',label:'Trade calendar timeline'}:null}
    ],
    outlook:[
      {horizon:'By October',title:'Existing trade keeps moving, but new investment waits for detail',text:'I expect companies already inside the North American supply chain to keep shipping. The larger risk is slower approval of new long-payback plants while sector rules and tariffs remain open.',trigger:'the three governments agree to a durable extension or publish sector rules that remove the main uncertainty.'},
      {horizon:'Next quarter',title:'Chinese content becomes a central negotiating issue',text:'Mexico depends on Asian machinery and components while selling finished goods north. I expect rules of origin and alleged transshipment to receive more attention than the headline trade balance.',trigger:'the review produces no new enforcement, disclosure or content requirements for the sectors most exposed.'}
    ],
    updates:changedMatches('trade',3),
    upcoming:eventMatches(/USMCA|tariff|trade|export|import/i,5),
    sources:[topicSource('banxico-exports-total'),topicSource('banxico-imports-total'),topicSource('banxico-trade-balance'),topicSource('banxico-imports-intermediate'),topicSource('banxico-imports-capital'),{label:'UN COMTRADE · partner and product shares',href:'https://comtradeplus.un.org/TradeFlow/',date:String(pYear)},...(fdiFact?[{label:fdiFact.source,href:fdiFact.url,date:'2025'}]:[]),...(usmca?[{label:'USTR · USMCA review',href:usmca.url,date:shortDate(usmca.date)}]:[])],
    method:`The ${EDITION.label} analysis uses observations available through ${EDITION.dataThrough}. Export and import totals come from Banxico. Product and partner shares come from UN COMTRADE and are checked against Banxico; the sources are not spliced into one series. Each chart links to its current series.`
  };
}

function politicsTopic(){
  const editionDay=dateObj(EDITION.publishedISO);editionDay.setUTCHours(0,0,0,0);
  const today=new Date();today.setUTCHours(0,0,0,0);
  const relevant=e=>e.date&&e.sourceUrl&&(e.kind==='political'||e.kind==='fiscal'||/Congress|election|electoral|budget|informe|presidential/i.test(`${e.label} ${e.mechanism||''}`));
  const editionOfficial=DB.events.filter(e=>relevant(e)&&dateObj(e.date)>=editionDay).sort((a,b)=>String(a.date).localeCompare(String(b.date)));
  const liveOfficial=DB.events.filter(e=>relevant(e)&&dateObj(e.date)>=today).sort((a,b)=>String(a.date).localeCompare(String(b.date)));
  if(!editionOfficial.length)throw new Error('Political calendar is unavailable');
  const editionEvent=editionOfficial[0],nextEvent=liveOfficial[0]||editionEvent,daysAway=Math.round((dateObj(editionEvent.date)-editionDay)/86400000);
  const fiscal=editionOfficial.filter(e=>e.kind==='fiscal');
  const shortName=l=>esc(String(l).split('\u2014')[0].split('(')[0].trim());
  const timelineItems=editionOfficial.slice(0,6).map(e=>({date:shortDate(e.date)+' '+dateObj(e.date).getUTCFullYear(),title:e.label,text:e.mechanism||'Official dated event.'}));
  const updates=changedMatches('politics',3);
  const politicalFact=standing('std-political-system'),judicialFact=standing('std-judicial-reform');
  const midterm=editionOfficial.find(e=>/midterm|midterm|elecci[oó]n.*2027|federal.*2027/i.test(`${e.label} ${e.mechanism||''}`));
  const revenue=editionOfficial.find(e=>/revenue|ingresos/i.test(`${e.label} ${e.mechanism||''}`));
  const budget=editionOfficial.find(e=>/budget|presupuesto/i.test(`${e.label} ${e.mechanism||''}`));
  return {
    title:'Politics',
    asof:`Published ${EDITION.published} · calendar through ${dateLabel(last(editionOfficial).date)}`,
    lead:`Mexico can change national rules quickly. Claudia Sheinbaum won 59.76% of the vote in 2024, and the governing coalition has already shown it can pass constitutional changes. The first federal judicial election drew turnout near 13%. For a company, that puts less weight on whether a reform can pass and more on the rules that follow, the agency applying them and the court that enforces them.<br><br>My base case is that the government keeps moving its priorities through Congress, while funding and execution become the constraint. The 2027 economic package is due September 8 and will show which promises have money behind them. I would change that view if secondary rules arrive on time, agencies enforce them consistently and court outcomes become more predictable. Until then, investors should price legal and regulatory execution into a deal. Operators should not treat passage as implementation.`,
    next:`${shortName(nextEvent.label)}, ${shortDate(nextEvent.date)}, ${dateObj(nextEvent.date).getUTCFullYear()}${daysAway>0?` (${fmt(daysAway,0)} days away)`:''}`,
    readings:[
      {label:'Next official date',value:shortDate(nextEvent.date),change:shortName(nextEvent.label),context:nextEvent.mechanism||'Official calendar event.',source:nextEvent.source,sourceHref:nextEvent.sourceUrl,date:String(dateObj(nextEvent.date).getUTCFullYear())},
      {label:'Federal midterms',value:midterm?shortDate(midterm.date):'Jun 6',change:midterm?String(dateObj(midterm.date).getUTCFullYear()):'2027',context:'All 500 deputies and 17 governorships are scheduled to be on the ballot.',source:midterm?.source||'INE',sourceHref:midterm?.sourceUrl||'https://www.ine.mx/',date:midterm?String(dateObj(midterm.date).getUTCFullYear()):'2027'},
      {label:'Revenue-law deadline',value:revenue?shortDate(revenue.date):'Oct 31',change:revenue?String(dateObj(revenue.date).getUTCFullYear()):'2026',context:'This sets the federal government’s authorized revenue and borrowing.',source:revenue?.source||'Congress',sourceHref:revenue?.sourceUrl||'https://www.diputados.gob.mx/',date:revenue?String(dateObj(revenue.date).getUTCFullYear()):'2026'},
      {label:'Budget deadline',value:budget?shortDate(budget.date):'Nov 15',change:budget?String(dateObj(budget.date).getUTCFullYear()):'2026',context:'The spending plan shows which announced priorities are actually funded.',source:budget?.source||'Congress',sourceHref:budget?.sourceUrl||'https://www.diputados.gob.mx/',date:budget?String(dateObj(budget.date).getUTCFullYear()):'2026'}
    ],
    sections:[
      {h2:'Each date locks one piece of the year ahead',
       prose:[`Every date on this page settles something specific. <b>${shortName(editionEvent.label)}</b> came first in this edition's calendar, on ${shortDate(editionEvent.date)}${daysAway>0?`, ${fmt(daysAway,0)} days after publication`:''}. ${esc(String(editionEvent.mechanism||'').trim())}${/[.!?]$/.test(String(editionEvent.mechanism||'').trim())?'':'.'} One date sets what the government may tax. One sets who receives the money. One sets who sits in the chamber that votes on the next round. Every entry links to the statute that fixes it.`],
       chart:{title:'Political events and fiscal deadlines, by date',visual:timeline(timelineItems),legend:'',table:timelineTable(timelineItems),srcHtml:editionOfficial.slice(0,1).map(e=>`<a href="${e.sourceUrl}" target="_blank" rel="noopener">${esc(e.source)} ↗</a>`).join(''),label:'Political calendar timeline'}},
      {h2:'The budget is the one document that puts a number on intent',
       prose:[`A speech can say anything. The budget has to say how much.${fiscal.length?` ${shortName(fiscal[0].label)} must reach Congress by ${shortDate(fiscal[0].date)}, ${dateObj(fiscal[0].date).getUTCFullYear()}, and it states in figures what the government proposes to tax, to borrow and to spend.`:''} Between that package and the November votes, the record below is the running account. When any of it moves markets, the numbers land on the <a href="/economy.html">Economy</a> and <a href="/trade.html">Trade</a> pages.`]}
      ,{h2:'Judicial reform will be judged by cases, not by the decree',
       prose:[`${judicialFact?esc(judicialFact.fact):'Mexico has moved much of the federal judiciary from appointment to election.'}`,
        `For an operator or investor, the useful measures are practical: how long a commercial case takes, whether an injunction is enforced, and whether similar parties receive similar treatment. Those results will arrive slowly. Until they do, I would treat legal certainty as an implementation question, not as settled by either the reform's supporters or its critics.`]}
    ],
    outlook:[
      {horizon:'By November',title:'The budget exposes the real constraints',text:'I expect the economic package to show less room than the political agenda implies once pensions, interest, Pemex and transfers are funded. Infrastructure and public services will compete for what remains.',trigger:'the package raises durable revenue or materially reduces the large fixed claims on spending.'},
      {horizon:'Next quarter',title:'Execution matters more than passage',text:'The coalition can move legislation. I expect the harder questions to be regulatory detail, court enforcement and implementation by agencies and states.',trigger:'new rules are implemented on schedule with clear secondary regulation and consistent enforcement.'}
    ],
    updates:updates.length?updates.map(u=>({...u,text:''})):[{type:'Calendar',title:nextEvent.label,text:'',source:nextEvent.source,href:nextEvent.sourceUrl,date:shortDate(nextEvent.date)}],
    upcoming:liveOfficial.slice(0,5),
    sources:[...new Map([...editionOfficial.slice(0,8),...liveOfficial.slice(0,2)].map(e=>[e.source,{label:e.source,href:e.sourceUrl,date:e.date}])).values(),...(politicalFact?[{label:politicalFact.source,href:politicalFact.url,date:'2024–2026'}]:[]),...(judicialFact?[{label:judicialFact.source,href:judicialFact.url,date:'2024–2026'}]:[])],
    method:`The ${EDITION.label} review separates sourced facts from Alan's labeled view. Only calendar dates tied to an original source appear. The page does not predict election results without polling and seat evidence; its outlook is about budgets, implementation and institutional capacity.`
  };
}

function societyTopic(){
  const rem=s('banxico-remesas'),R=last(rem),RY=yearAgo(rem,R),unemp=s('inegi-desempleo'),U=last(unemp);
  const demo=DB.demographics,vitals=DB.vitals;
  const pop=demo?.population?.latest,popYear=demo?.latestYear,births=vitals?.births,deaths=vitals?.deaths;
  if(!R||!U||!Number.isFinite(pop)||!births?.latest||!deaths?.latest)throw new Error('Society inputs are incomplete');
  const bSeries=(births.series||[]).map(p=>({date:`${p.year}-01-01`,value:p.value})),dSeries=(deaths.series||[]).map(p=>({date:`${p.year}-01-01`,value:p.value}));
  const bFirst=births.series?.[0],tBirths=trendWord(births.latest.value,bFirst?bFirst.value:null);
  const tRem=trendWord(R.value,RY?RY.value:null);
  const line=(name,points,color,format)=>({name,points,color,format});
  const informalFact=standing('std-informal-economy'),povertyFact=standing('std-wages-poverty'),securityFact=standing('std-security-measures'),demoFact=standing('std-demographics');
  const informalPct=Number(/([\d.]+)%/.exec(informalFact?.fact||'')?.[1])||55.2,informalPeople=/about ([\d.]+ million)/i.exec(informalFact?.fact||'')?.[1]||'about 33.4 million people';
  const liveRem=sLive('banxico-remesas'),liveU=sLive('inegi-desempleo'),LR=last(liveRem)||R,LRY=yearAgo(liveRem.length?liveRem:rem,LR),LU=last(liveU)||U;
  return {
    title:'Society & security',
    asof:`Last revised ${shortDate(new Date().toISOString().slice(0,10))}, ${new Date().getUTCFullYear()} · newest number ${dateLabel(R.date)}`,
    lead:`Mexico has plenty of work, but not enough formal work. The latest unemployment reading was ${fmt(U.value,2)}%, while ${fmt(informalPct,1)}% of workers were informal in 2025. Security also looks different depending on the measure: the government reports preliminary daily homicides down sharply since September 2024, while INEGI estimates that more than nine in ten crimes are never reported or investigated. A national improvement can be real without changing what a business sees in payroll records, extortion or cargo theft.<br><br>My base case is low unemployment, slow formalization and better homicide headlines before security costs fall broadly for businesses. I would change that view if formal payroll and labor-force data improve together, and if prosecutor files, death certificates, victimization surveys and business reports of extortion and cargo theft also improve. For investors, Mexico is not one labor or security market. City, industry and distribution channel matter. Operators should budget for benefits, income verification and security locally, not from one national rate.`,
    next:watchFor(/employment|ENOE|unemployment|remittance|population/i)||'INEGI household releases; dates on the calendar below.',
    readings:[
      {label:'Unemployment',value:fmt(LU.value,2),unit:'%',change:quarterLabel(LU.date),context:'A low rate does not capture the quality or formality of work.',source:sourceName('inegi-desempleo'),sourceHref:sourceUrl('inegi-desempleo'),date:quarterLabel(LU.date)},
      {label:'Workers in informal employment',value:fmt(informalPct,1),unit:'%',change:informalPeople,context:'Work without full legal, tax or social-security protection.',source:informalFact?.source||'INEGI · ENOE',sourceHref:informalFact?.url||'https://www.inegi.org.mx/programas/enoe/15ymas/',date:'2025'},
      {label:'Remittances',value:`$${fmt(LR.value/1000,2)}`,unit:'bn',change:LRY?`${signed(pct(LR.value,LRY.value),1,'%')} from a year earlier`:'',context:'Dollar inflows support household spending; the peso determines what they buy locally.',source:sourceName('banxico-remesas'),sourceHref:sourceUrl('banxico-remesas'),date:dateLabel(LR.date),href:'/chart.html?q=remittances'},
      {label:'Projected population',value:fmt(pop/1e6,1),unit:'million',change:String(popYear),context:`Median age ${demo.medianAge}. This is a projection, not a census count.`,source:'CONAPO',sourceHref:demo.sourceUrl,date:String(popYear)}
    ],
    sections:[
      {h2:'Deaths are climbing toward births',
       prose:[`Mexico still records about two births for every death: <b>${fmt(births.latest.value/1e6,1)} million</b> births in ${births.latest.year} against roughly ${fmt(Math.round(deaths.latest.value/1e3),0)},000 deaths. Births still win. The gap narrows each year, and when the lines meet, the population grows only through migration, which these counts exclude. A smaller working-age base then carries more retirees, and pension and health costs grow into that gap.`],
       chart:bSeries.length>5?{title:'Registered births and deaths per year, millions',stat:`${fmt(births.latest.value/1e6,1)}m births`,series:[line('Births',bSeries,GREEN,v=>fmt(v/1e6,2)+'m'),line('Deaths',dSeries,INK,v=>fmt(v/1e6,2)+'m')],yFormat:v=>fmt(v/1e6,1)+'m',label:'Registered births and deaths per year',srcHtml:`<a href="${births.sourceUrl}" target="_blank" rel="noopener">INEGI · registered births ↗</a>`}:null},
      {h2:'Dollars arrive, pesos get spent',
       prose:[`The exchange rate decides what that money is worth at home. Families are paid in dollars and spend in pesos.${tRem.known?` ${dateLabel(R.date)}'s inflow ran ${fmt(Math.abs(tRem.pct),1)}% ${tRem.pct>=0?'above':'below'} the same month a year earlier.`:''} A stronger peso can erase that gain before it reaches a grocery bill. More dollars do not always mean more groceries.`],
       chart:{title:'Remittances per month, US$ billions',stat:`$${fmt(R.value/1000,1)}bn`,series:[line('Remittances',rem.slice(-72).map(p=>({date:p.date,value:p.value/1000})),GREEN,v=>'$'+fmt(v,1)+'bn')],yFormat:v=>'$'+fmt(v,1)+'bn',label:'Monthly remittance inflows',srcId:'banxico-remesas'}},
      {h2:'Low unemployment hides the structure of the labor market',
       prose:[`${informalFact?esc(informalFact.fact):`Unemployment was ${fmt(U.value,2)}%, while more than half of workers remained informal.`}`,
        `For an employer, this means a large labor pool but uneven skills, benefits and payroll records. For the government, it means a narrower tax base. For a lender, it means millions of incomes that are harder to verify. The headline unemployment rate looks excellent; the informality rate explains why it does not feel like a fully developed labor market.`],
       chart:{title:'Unemployment rate, percent of the labor force',stat:`${fmt(U.value,2)}%`,series:[line('Unemployment',unemp,GREEN,v=>fmt(v,2)+'%')],yFormat:v=>fmt(v,1)+'%',label:'INEGI national unemployment rate',srcId:'inegi-desempleo'}},
      {h2:'Security needs more than one official series',
       prose:[`${securityFact?esc(securityFact.fact):'Reported offenses, victimization surveys and homicide records measure different things.'}`,
        `A decline in preliminary homicide counts would matter. It would not, by itself, settle extortion, cargo theft or the share of crimes never reported. I would want prosecutor files, death certificates, victimization surveys and business reports to move in the same direction before taking a broad view on security.`]}
    ],
    outlook:[
      {horizon:'Next quarter',title:'Formalization improves only slowly',text:'I expect unemployment to remain low while informality stays near half of the workforce. The hard test is not whether people have some work, but whether formal payroll jobs, benefits and firm productivity rise.',trigger:'formal employment and labor-force survey data improve together for several releases.'},
      {horizon:'Next few years',title:'Aging becomes an economic constraint before it becomes a population decline',text:'Fewer births will first show up in school enrollment and the future labor pool, while pension and health obligations keep growing. Businesses should expect slower labor-force growth long before the population peaks.',trigger:'fertility, migration or productivity moves enough to materially change the projected worker-to-retiree balance.'}
    ],
    updates:changedMatches('society',3),
    upcoming:eventMatches(/unemployment|remittance|wage|poverty|population|migration|employment/i,5),
    sources:[topicSource('inegi-desempleo'),topicSource('banxico-remesas'),{label:'INEGI · ENOE informality',href:'https://www.inegi.org.mx/programas/enoe/15ymas/',date:'2025'},{label:'CONAPO · population projections',href:demo.sourceUrl,date:String(popYear)},{label:'INEGI · registered births',href:births.sourceUrl,date:String(births.latest.year)},{label:'INEGI · registered deaths',href:deaths.sourceUrl,date:String(deaths.latest.year)},...(securityFact?[{label:securityFact.source,href:securityFact.url,date:'2024–2026'}]:[])],
    method:`The ${EDITION.label} analysis uses observations available through ${EDITION.dataThrough}. Population is a projection; births and deaths are registrations; unemployment and informality come from labor-force surveys. Security measures are kept separate because reported offenses, victimization and death records answer different questions.`
  };
}

function usMexicoTopic(){
  const tu=DB.tradeUS||{},importsAll=(tu.series?.imports||[]).map(p=>({date:p.month+'-01',value:+p.value})),exportsAll=(tu.series?.exports||[]).map(p=>({date:p.month+'-01',value:+p.value}));
  const imports=importsAll.filter(p=>p.date<=EDITION.cutoff),exports=exportsAll.filter(p=>p.date<=EDITION.cutoff),FI=last(imports),FE=last(exports),L=tu.latest||{};
  const partners=DB.partners?.exports?.items||[],us=partners.find(x=>x.name==='USA'),partnerYear=Number(DB.partners?.referenceYear||DB.partners?.year);
  if(!L.month||!Number.isFinite(Number(L.twoway_bn))||!FI||!FE||FI.date!==FE.date||!us||!Number.isFinite(partnerYear))throw new Error('U.S.-Mexico inputs are incomplete');
  const tradeMonth=FI.date,quarterlyTwoWay=FI.value+FE.value,quarterlySurplus=FI.value-FE.value,liveTradeMonth=L.month+'-01';
  const censusMexicoUrl='https://www.census.gov/foreign-trade/balance/c2010.html';
  const usmca=DB.happening.find(e=>e.id==='usmca-not-renewed-2026-07-01');
  const next=eventMatches(/USMCA|U.S.|US-Mexico|tariff|trade talks|border|bilateral/i,6,/Presupuesto|Paquete|Ley de Ingresos|foreign direct investment|IED/i);
  const rem=sLive('banxico-remesas'),frozenRem=s('banxico-remesas'),LR=last(rem)||last(frozenRem),LRY=yearAgo(rem.length?rem:frozenRem,LR);
  const dependenceFact=standing('std-us-dependence'),chinaFact=standing('std-china-inputs'),migrationFact=standing('std-migration'),energyFact=standing('std-energy-constraint'),reviewFact=standing('std-usmca-review');
  if(!LR)throw new Error('U.S.-Mexico remittance input is incomplete');
  const line=(name,points,color,format)=>({name,points,color,format});
  return {
    title:'U.S. and Mexico',
    lead:`Mexico's economic relationship with the United States is hard to replace and getting harder to plan around. The U.S. bought ${fmt(us.share,1)}% of Mexico's goods exports in ${partnerYear}, and two-way goods trade reached $${fmt(quarterlyTwoWay,1)} billion in ${dateLabel(tradeMonth)}. The United States–Mexico–Canada Agreement (USMCA) still governs that commerce, but the annual review gives Washington repeated chances to press Mexico on Chinese inputs, border enforcement and energy. Existing factories can keep shipping; a new project that needs a decade of stable rules has a harder call.<br><br>My base case is continued trade with more sector-by-sector friction. I would change that view if the three governments agree to a durable extension, or if the United States applies broad measures that interrupt trade which currently complies with USMCA. For investors, I prefer established exporters and suppliers that can document North American content to long-payback projects built on unchanged rules. Operators should put rules-of-origin records, customs delays and alternate suppliers into the operating plan.`,
    next:watchFor(/USMCA|tariff|trade talks/i)||'The next bilateral dates are on the calendar below.',
    readings:[
      {label:'Two-way goods trade',value:`$${fmt(Number(L.twoway_bn),1)}`,unit:'bn',change:dateLabel(liveTradeMonth),context:'U.S. imports from Mexico plus U.S. exports to Mexico for the month.',source:'U.S. Census',sourceHref:censusMexicoUrl,date:dateLabel(liveTradeMonth)},
      {label:'Mexican exports sold to the U.S.',value:fmt(us.share,1),unit:'%',change:String(partnerYear),context:'This concentration makes access to the U.S. market unusually important for Mexican output and jobs.',source:'UN COMTRADE',sourceHref:'https://comtradeplus.un.org/TradeFlow/',date:String(partnerYear)},
      {label:'Mexico goods surplus with the U.S.',value:`$${fmt(Math.abs(Number(L.balance_bn)),1)}`,unit:'bn',change:dateLabel(liveTradeMonth),context:'The U.S. bought this much more from Mexico than it sold back during the month.',source:'U.S. Census',sourceHref:censusMexicoUrl,date:dateLabel(liveTradeMonth)},
      {label:'Remittances to Mexico',value:`$${fmt(LR.value/1000,2)}`,unit:'bn',change:LRY?`${signed(pct(LR.value,LRY.value),1,'%')} from a year earlier`:'',context:'Mostly household money tied to work and families across the border.',source:sourceName('banxico-remesas'),sourceHref:sourceUrl('banxico-remesas'),date:dateLabel(LR.date),href:'/chart.html?q=remittances'}
    ],
    sections:[
      {h2:`The trade is enormous, but the dependence is not equal`,
       prose:[`The United States bought <b>$${fmt(FI.value,1)} billion</b> of Mexican goods in ${dateLabel(tradeMonth)} and sold $${fmt(FE.value,1)} billion back. Mexico's surplus was $${fmt(quarterlySurplus,1)} billion. The total matters more than the score: factories on both sides cross the border repeatedly before a vehicle or appliance is finished.`,
        `${dependenceFact?esc(dependenceFact.fact):`${fmt(us.share,1)}% of Mexican goods exports go to the United States.`} Mexico is therefore more exposed to a border delay or tariff change than the U.S. economy as a whole. For an operator, a policy dispute in Washington can become a question about Mexican inventory, payroll and investment within days.`],
       chart:{title:'U.S. goods trade with Mexico, monthly, US$ billions',stat:`$${fmt(quarterlyTwoWay,1)}bn`,series:[line('U.S. buys from Mexico',imports,GREEN,v=>'$'+fmt(v,1)+'bn'),line('U.S. sells to Mexico',exports,INK,v=>'$'+fmt(v,1)+'bn')],yFormat:v=>'$'+fmt(v,0),label:'Monthly U.S. imports from and exports to Mexico',srcHtml:`<a href="${censusMexicoUrl}" target="_blank" rel="noopener">U.S. Census · trade with Mexico ↗</a>`}},
      {h2:'The relationship runs through households and power plants too',
       prose:[`${migrationFact?esc(migrationFact.fact):'Migration, return and remittances connect millions of households across the border.'}`,`${energyFact?esc(energyFact.fact):'Mexico also depends on energy flows from the United States.'} Trade negotiations attract the attention, but immigration enforcement, customs processing, water and reliable energy can move companies and families just as quickly. I would not judge the relationship from the goods balance alone.`]},
      {h2:'Annual reviews make Chinese inputs part of every investment decision',
       prose:[`The United States–Mexico–Canada Agreement (USMCA) remains in force. ${reviewFact?esc(reviewFact.fact).replace(/^Trade under USMCA continues\.\s*/,''):`${usmca?esc(usmca.title)+'. ':''}It is now reviewed annually.`}`,`${chinaFact?esc(chinaFact.fact):'Mexico depends on imported machinery and components from China.'} That creates the central trade-off: those inputs keep Mexican factories competitive, while Washington wants more North American content and tighter enforcement. Existing production is likely to keep moving. New projects that need ten years of stable rules have a harder decision.`]}
    ],
    outlook:[
      {horizon:'By October',title:'Trade continues, with more sector-by-sector friction',text:'I expect the agreement to remain in force and factories to keep shipping. The negotiations are more likely to produce tighter rules, investigations and exemptions by sector than a clean break in trade.',trigger:'the three governments agree to a durable extension, or the United States applies broad measures that materially interrupt compliant trade.'},
      {horizon:'Next quarter',title:'Chinese content stays near the center of the review',text:'Autos, electronics and machinery all rely on imported components. I expect rules of origin, forced-labor enforcement and alleged transshipment to shape where companies source and what they document.',trigger:'the next negotiating round ends without new scrutiny or enforcement aimed at non-North-American content.'}
    ],
    updates:changedMatches('usmexico',3),
    upcoming:next.slice(0,5),
    sources:[...(usmca?[{label:'USTR · USMCA first review',href:usmca.url,date:shortDate(usmca.date)}]:[]),{label:'U.S. Census · trade with Mexico',href:censusMexicoUrl,date:tu.meta?.latestMonth},{label:'UN COMTRADE · export exposure and China trade',href:'https://comtradeplus.un.org/TradeFlow/',date:String(partnerYear)},topicSource('banxico-remesas'),...(migrationFact?[{label:migrationFact.source,href:migrationFact.url,date:'2018–2023'}]:[]),...(energyFact?[{label:energyFact.source,href:energyFact.url,date:'current structure'}]:[])],
    method:`The ${EDITION.label} trade argument uses U.S. Census monthly goods data and UN COMTRADE partner data. Migration, energy and remittances remain separate measures with their own sources and dates. Latest developments update below the review; the published argument does not silently change.`
  };
}

const BUILDERS={economy:economyTopic,payments:paymentsTopic,trade:tradeTopic,politics:politicsTopic,society:societyTopic,usmexico:usMexicoTopic};
let current=ROUTE_TOPIC;
function validTopic(){return TOPIC_ORDER.includes(ROUTE_TOPIC)?ROUTE_TOPIC:'economy';}
function renderSources(t){return `<div class="source-list">${t.sources.map(x=>`<div><a href="${esc(x.href)}" target="_blank" rel="noopener">${esc(x.label)} ↗</a>${x.date?` · observation ${esc(x.date)}`:''}</div>`).join('')}</div><p>${esc(t.method)}</p>`;}
function evidenceBlock(e,id,label='In the data'){
  if(!e)return '';
  const titleId=id+'-title',visualId=id+'-visual',tableId=id+'-table';
  return `<section class="section ${e.css||''}" id="${id}" aria-labelledby="${titleId}"><div class="section-head"><div><div class="mono-k">${label}</div><h2 id="${titleId}">${e.k}</h2></div></div><article class="evidence-shell"><header class="evidence-head"><div><h3>${e.title}</h3><div class="evidence-sub">${e.sub}</div></div><div class="view-toggle" role="group" aria-label="Choose ${e.k} view"><button type="button" class="active" aria-pressed="true" data-evidence-for="${id}" data-evidence="visual">${e.visualLabel||'Chart'}</button><button type="button" aria-pressed="false" data-evidence-for="${id}" data-evidence="table">${e.tableLabel||'Table'}</button></div></header><div class="evidence-body" id="${visualId}">${e.legend?`<div class="chart-legend">${e.legend}</div>`:''}<div class="chart-wrap">${e.visual}</div><div class="chart-note">${e.note}${evidenceSources(e.sources)}</div></div><div class="table-wrap" id="${tableId}">${e.table}</div><div class="evidence-read"><div><h4>What it shows</h4><p>${e.read[0]}</p></div><div><h4>What it does not show</h4><p>${e.read[1]}</p></div></div></article></section>`;
}
// The chart card, stripped to four elements (Fable restart 2026-07-20): a plain title with
// units folded in, the current value, the chart with its crosshair, and ONE footer line
// carrying provenance and the table toggle. Everything else the old card wore is gone.
function chartSrcLine(c){
  if(c.srcHtml)return c.srcHtml;
  const ids=[c.srcId,c.srcId2].filter(Boolean);
  return ids.map(id=>`<a href="${sourceUrl(id)}" target="_blank" rel="noopener">${sourceName(id)}${seriesId(id)?` · ${seriesId(id)}`:''} ↗</a>`).join(' · ')+(ids.length?` · through ${dateLabel(obs(ids[0]))}`:'');
}
function chartShell(c,id){
  const visual=c.visual||chartSVG({series:c.series,yFormat:c.yFormat,label:c.label,band:c.band||null});
  const table=c.table||dataTable(c.series,12),ids=[c.srcId,c.srcId2].filter(Boolean),liveHref=c.liveHref||(ids.length?`/chart.html?v=${encodeURIComponent(ids.join(','))}`:'');
  return `<article class="chart-card ${c.css||''}"><header class="chart-head"><h3>${c.title}</h3>${c.stat?`<div class="chart-stat">${c.stat}</div>`:''}</header><div class="evidence-body" id="${id}-visual">${c.visual?(c.legend||''):`<div class="chart-legend">${legend(c.series)}</div>`}<div class="chart-wrap">${visual}</div></div><div class="table-wrap" id="${id}-table">${table}</div><div class="chart-foot"><span>${chartSrcLine(c)}</span><div class="chart-actions">${liveHref?`<a href="${liveHref}">Open current chart →</a>`:''}<button type="button" class="tbl-toggle" data-evidence-for="${id}" aria-controls="${id}-visual ${id}-table" aria-pressed="false">Table</button></div></div></article>`;
}
// The crosshair (Alan 2026-07-20): pointer over any chart snaps to the nearest observation,
// draws a vertical guide and a dot per series, and shows a tooltip with the date and each
// pre-formatted value. pointerdown covers tap-to-inspect on phones. Delegated once on the
// document, so it survives every re-render and needs no per-chart wiring.
(function(){
  function clearHover(holder){const tip=holder.querySelector('.chart-tip');if(tip)tip.hidden=true;holder.querySelectorAll('svg .hv').forEach(g=>{g.innerHTML='';});}
  function onPoint(ev){
    const svg=ev.target.closest?.('.chart-hover svg');
    if(!svg)return;
    const holder=svg.closest('.chart-hover');
    const data=holder._hd||(holder._hd=JSON.parse(holder.dataset.series));
    const a=svg.dataset,W=+a.w,H=+a.h,L=+a.l,R=+a.r,T=+a.t,B=+a.b,x0=+a.x0,x1=+a.x1,y0=+a.y0,y1=+a.y1;
    const rect=svg.getBoundingClientRect();
    const xv=(ev.clientX-rect.left)/rect.width*W;
    if(xv<L-6||xv>W-R+6){clearHover(holder);return;}
    const tt=x0+(Math.min(Math.max(xv,L),W-R)-L)/(W-L-R||1)*(x1-x0||1);
    const rows=[];let snap=null,snapD=Infinity;
    for(const s of data){let best=null,bd=Infinity;for(const p of s.p){const d=Math.abs(p[0]-tt);if(d<bd){bd=d;best=p;}}if(!best)continue;rows.push({s,p:best});if(bd<snapD){snapD=bd;snap=best;}}
    if(!rows.length)return;
    const X=v=>L+(v-x0)/(x1-x0||1)*(W-L-R),Y=v=>T+(y1-v)/(y1-y0||1)*(H-T-B);
    const g=svg.querySelector('.hv');
    const cx=X(snap[0]).toFixed(1);
    g.innerHTML=`<line class="hv-line" x1="${cx}" x2="${cx}" y1="${T}" y2="${H-B}"/>`+rows.map(r=>`<circle class="hv-dot" cx="${X(r.p[0]).toFixed(1)}" cy="${Y(r.p[1]).toFixed(1)}" r="4.5" fill="${r.s.c}"/>`).join('');
    let tip=holder.querySelector('.chart-tip');
    if(!tip){tip=document.createElement('div');tip.className='chart-tip';holder.appendChild(tip);}
    tip.hidden=false;
    tip.innerHTML=`<div class="tip-d">${esc(snap[3])}</div>`+rows.map(r=>`<div class="tip-r"><i style="background:${r.s.c}"></i><span>${esc(r.s.n)}</span><b>${esc(r.p[2])}</b></div>`).join('');
    const hr=holder.getBoundingClientRect();
    let leftPx=ev.clientX-hr.left+16;const tw=tip.offsetWidth||170;
    if(leftPx+tw>hr.width-4)leftPx=Math.max(4,ev.clientX-hr.left-tw-16);
    tip.style.left=leftPx+'px';
    tip.style.top=Math.max(0,ev.clientY-hr.top-tip.offsetHeight-14)+'px';
  }
  document.addEventListener?.('pointermove',onPoint);
  document.addEventListener?.('pointerdown',onPoint);
  document.addEventListener?.('pointerout',(ev)=>{const holder=ev.target.closest?.('.chart-hover');if(holder&&!(ev.relatedTarget&&holder.contains(ev.relatedTarget)))clearHover(holder);});
})();
function render(topic){
  current=topic;let t;
  try{t=BUILDERS[topic]();}
  catch(error){
    console.error(error);window.reportMexicoDataError?.(`topic:${topic}`);
    $('#topicApp').className='';
    $('#topicApp').innerHTML=`<section class="topic-hero"><div><h1>${LABELS[topic]}</h1><p class="topic-scope">This page is waiting for its required source data.</p></div></section><section class="now"><div class="mono-k">Data check</div><div><h2>This page couldn't load its source data. Try again, or check feed status.</h2><p><a href="/sources.html#livenow">Open feed status →</a></p></div></section>`;
    return;
  }
  $$('.topic-switch a').forEach(b=>b.classList.toggle('active',b.dataset.topic===topic));$('.topic-select').value=topic;
  // The dated quarterly argument stays fixed. Only the small developments and readings
  // layer above it keeps moving, so new data never silently rewrites an old conclusion.
  $('#topicApp').className='';
  $('#topicApp').innerHTML=`
    <section class="topic-hero"><div><div class="edition-label">Quarterly review</div><h1>${t.title}</h1><div class="edition-meta">${EDITION.label} · Published ${EDITION.published} · Data through ${EDITION.dataThrough} · Next review ${EDITION.next}</div><div class="edition-contract">The figures are sourced. The argument and forecasts are mine.</div></div></section>
    <section class="now"><div class="mono-k">My view</div><p class="lead">${t.lead}</p></section>
    <section class="section quarterly-start"><div class="mono-k">${EDITION.label} review</div><h2>What changed this quarter</h2></section>
    ${t.sections.map((sec,i)=>`<section class="section story-sec"><h2>${String(sec.h2).replace(/\.\s*$/,'')}</h2>${sec.prose.map(p=>`<p class="story-p">${p}</p>`).join('')}${sec.chart?chartShell(sec.chart,'story-ev-'+i):''}</section>`).join('')}
    ${t.outlook?.length?`<section class="section"><div class="section-head"><div><div class="mono-k">My outlook</div><h2>What I expect by the next review</h2></div></div>${outlookList(t.outlook)}</section>`:''}
    <section class="section"><div class="section-head"><div><div class="mono-k">The calendar</div><h2>What to watch</h2></div><div class="section-note">Only dated releases, meetings and decisions that could change the view.</div></div>${upcomingList((t.upcoming||[]).slice(0,4))}</section>
    ${t.updates?.length?`<section class="section live-section"><div class="section-head"><div><div class="mono-k">Live</div><h2>Latest developments</h2></div><div class="section-note">Updates as verified sources arrive. The quarterly review above remains dated.</div></div>${updateList(t.updates)}</section>`:''}
    <details class="sources"><summary>Sources and method</summary><div class="sources-body">${renderSources(t)}</div></details>`;
  $$('.tbl-toggle').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.evidenceFor,showTable=b.getAttribute('aria-pressed')!=='true';b.setAttribute('aria-pressed',String(showTable));b.textContent=showTable?'Chart':'Table';$('#'+id+'-visual').classList.toggle('hidden',showTable);$('#'+id+'-table').classList.toggle('open',showTable)}));
}
$('.topic-switch').innerHTML=TOPIC_ORDER.map(t=>`<a href="${ROUTES[t]}" data-topic="${t}"${t===validTopic()?' aria-current="page"':''}>${LABELS[t]}</a>`).join('');
$('.topic-select').innerHTML=TOPIC_ORDER.map(t=>`<option value="${t}">${LABELS[t]}</option>`).join('');
$('.topic-select').addEventListener('change',e=>{location.href=ROUTES[e.target.value]});
render(validTopic());
</script>
