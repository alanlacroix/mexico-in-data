  const I=last(inf),Ic=last(core),R=last(rateRaw),G=last(igae),GDP=last(gdp),P=last(peso),C=last(credit),CY=yearAgo(credit,C),F=atOrBefore(fed,P?.date)||last(fed);
  if(!I||!Ic||!R||!G||!GDP||!P||!C||!F)throw new Error('Economy inputs are incomplete');
  const P3=atOrBefore(peso,new Date(dateObj(P.date).getTime()-90*86400000).toISOString().slice(0,10));
  const lastMove=(()=>{for(let i=rateRaw.length-1;i>0;i--){if(rateRaw[i].value!==rateRaw[i-1].value)return {bp:Math.round((rateRaw[i].value-rateRaw[i-1].value)*100),date:rateRaw[i].date};}return null;})();
  const d3=pct(P.value,P3?P3.value:null),pesoWeaker=d3!=null&&d3>0.5,pesoStronger=d3!=null&&d3<-0.5;
