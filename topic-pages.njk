  const line=(name,points,color,format)=>({name,points,color,format});
  const newest=[S.date,C.date].sort().at(-1);
  const liveSpei=sLive('banxico-spei-operaciones'),liveDebit=sLive('banxico-tpv-debito-ops'),liveCredit=sLive('banxico-tpv-credito-ops'),liveCirc=sLive('banxico-circulante');
  const LS=last(liveSpei)||S,LSP=prior(liveSpei.length?liveSpei:spei),LCard=last(sumShared(liveDebit,liveCredit))||Card,LDebit=liveDebit.find(p=>p.date===LCard?.date)||Debit,LC=last(liveCirc)||C,LCY=yearAgo(liveCirc.length?liveCirc:circ,LC)||CYr;
