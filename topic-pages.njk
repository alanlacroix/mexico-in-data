function watchFor(rx){const e=eventMatches(rx,1)[0];if(!e)return '';const d=dateObj(e.date);return `${esc(String(e.label).split('—')[0].split('(')[0].trim())}, ${shortDate(e.date)}, ${d.getUTCFullYear()}${e.approx?' (approximate)':''}`;}
