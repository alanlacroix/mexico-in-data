      {label:'Economic activity',value:signed(LG.value,2,'%'),change:'from a year earlier',context:'IGAE is the monthly pulse. Quarterly GDP is broader and arrives later.',source:sourceName('banxico-igae'),sourceHref:sourceUrl('banxico-igae'),date:dateLabel(LG.date),href:'/chart.html?v=banxico-igae,banxico-pib-crecimiento'}
    ],
    sections:[
      {h2:Ic.value>I.value+0.15?`Core inflation is still higher than headline inflation`:`Core inflation is below headline inflation`,
