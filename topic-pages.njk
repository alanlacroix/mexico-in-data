function latest12Total(id){const a=s(id);return a.slice(-12).reduce((t,p)=>t+p.value,0)/1e6;}
function deltaText(v,unit='%',n=1){if(v==null||!Number.isFinite(v))return 'Comparison unavailable';return `${v>0?'↑':v<0?'↓':'→'} ${fmt(Math.abs(v),n)}${unit}`;}
function card({label,value,unit='',change,context,guide,source,date,sourceHref=SOURCE_FALLBACK,href=''}){return `<article class="reading-card"><div class="reading-label">${label}</div><div class="reading-value">${value}${unit?` <small>${unit}</small>`:''}</div><div class="reading-change">${change||''}</div><div class="reading-context">${context||''}</div><div class="reading-source"><a href="${sourceHref}" target="_blank" rel="noopener">${source||'Source'} ↗</a>${date?`<span>· ${date}</span>`:''}${href&&href!==sourceHref?`<a class="reading-open" href="${href}">Open →</a>`:''}</div></article>`;}
