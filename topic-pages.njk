function atOrBefore(a,target){const t=dateObj(target);return [...a].reverse().find(p=>dateObj(p.date)<=t);}
function yearAgo(a,p=last(a)){
  if(!p||!a.length)return null;const d=dateObj(p.date);d.setUTCFullYear(d.getUTCFullYear()-1);const target=d.getTime();
  const nearest=a.reduce((best,x)=>Math.abs(dateObj(x.date).getTime()-target)<Math.abs(dateObj(best.date).getTime()-target)?x:best,a[0]);
  return Math.abs(dateObj(nearest.date).getTime()-target)<=1000*60*60*24*50?nearest:null;
}
function monthMap(a){return Object.fromEntries(a.map(p=>[p.date.slice(0,7),p.value]));}
