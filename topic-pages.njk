  const vintage=String(meta?.vintage||''),match=/^(\d{4})-(\d{2})/.exec(vintage);
  if(!match)return vintage;
  const end=new Date(`${match[1]}-${match[2]}-01T00:00:00Z`).toLocaleDateString('en-US',{month:'short',timeZone:'UTC'});
  const cumulative=/acumulado del año|year[- ]to[- ]date|enero[–-]/i.test(`${meta?.units||''} ${meta?.notes||''}`);
  return cumulative?(end==='Jan'?`Jan ${match[1]}`:`Jan–${end} ${match[1]}`):`${end} ${match[1]}`;
};
const quarterLabel=d=>{const x=dateObj(d);return `Q${Math.floor(x.getUTCMonth()/3)+1} ${x.getUTCFullYear()}`;};
const shortDate=d=>dateObj(d).toLocaleDateString('en-US',{month:'short',day:'numeric',timeZone:'UTC'});
const seriesId=id=>/\/series\/([A-Za-z0-9._-]+)/.exec(meta(id).sourceUrl||'')?.[1]||'';
