function chartSVG({series,yFormat=v=>fmt(v,1),label,band=null}){
  const all=series.flatMap(x=>x.points||[]);if(!all.length)return '<p class="chart-note">No chart data is available.</p>';
  const sorted=[...all].sort((a,b)=>a.date.localeCompare(b.date)),x0=Math.min(...all.map(p=>dateObj(p.date).getTime())),x1=Math.max(...all.map(p=>dateObj(p.date).getTime()));
  let y0=Math.min(...all.map(p=>p.value),...(band||[])),y1=Math.max(...all.map(p=>p.value),...(band||[]));const pad=(y1-y0||1)*.12;y0-=pad;y1+=pad;
  // Hover payload (Alan 2026-07-20: "like Google charts where I can drag my mouse along the
  // line"): every point pre-formatted before the interaction exists, so the crosshair only
  // positions and prints. It can never invent a number the chart does not carry.
  const hoverData=series.map(x=>({n:x.name,c:x.color,p:(x.points||[]).map(pt=>{const d=dateObj(pt.date);return [d.getTime(),pt.value,x.format(pt.value),d.getUTCDate()===1?dateLabel(pt.date):`${shortDate(pt.date)}, ${d.getUTCFullYear()}`];})}));
  const hoverJson=JSON.stringify(hoverData).replace(/&/g,'&amp;').replace(/'/g,'&#39;');
  function one(W,H,L,R,T,B,mobile){
    const X=d=>L+(dateObj(d).getTime()-x0)/(x1-x0||1)*(W-L-R),Y=v=>T+(y1-v)/(y1-y0)*(H-T-B),tickCount=mobile?3:4;
    const ticks=Array.from({length:tickCount},(_,i)=>y0+(y1-y0)*i/(tickCount-1)),dates=mobile?[x0,x1]:[x0,x0+(x1-x0)/2,x1];
    const bandSvg=band?`<rect class="target-band" x="${L}" y="${Y(band[1])}" width="${W-L-R}" height="${Math.max(0,Y(band[0])-Y(band[1]))}"/>`:'';
    const grids=ticks.map(v=>`<line class="grid-line" x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}"/><text class="axis-text" x="${L-7}" y="${Y(v)+4}" text-anchor="end">${esc(yFormat(v))}</text>`).join('');
    const paths=series.map(x=>{const d=x.points.map((p,i)=>`${i?'L':'M'} ${X(p.date).toFixed(1)} ${Y(p.value).toFixed(1)}`).join(' '),e=last(x.points);return `<path class="chart-line" d="${d}" stroke="${x.color}"/><circle class="chart-dot" cx="${X(e.date)}" cy="${Y(e.value)}" r="4" fill="${x.color}"/>`;}).join('');
    const axes=dates.map(t=>`<text class="axis-text" x="${L+(t-x0)/(x1-x0||1)*(W-L-R)}" y="${H-8}" text-anchor="${t===x0?'start':t===x1?'end':'middle'}">${new Date(t).toLocaleDateString('en-US',{year:'numeric',month:x1-x0<86400000*800?'short':undefined,timeZone:'UTC'})}</text>`).join('');
    return `<svg class="chart-${mobile?'mobile':'desktop'}" viewBox="0 0 ${W} ${H}" data-w="${W}" data-h="${H}" data-l="${L}" data-r="${R}" data-t="${T}" data-b="${B}" data-x0="${x0}" data-x1="${x1}" data-y0="${y0}" data-y1="${y1}" role="img" aria-label="${esc(label)}"><title>${esc(label)}</title><desc>Line chart from ${dateLabel(sorted[0].date)} to ${dateLabel(last(sorted).date)}.</desc>${bandSvg}${grids}${paths}${axes}<g class="hv"></g></svg>`;
  }
  return `<div class="chart-hover" data-series='${hoverJson}'>`+one(900,250,65,25,14,32,false)+one(360,235,44,8,12,27,true)+`</div>`;
}
