function dataTable(series,rows=null){
  let keys=[...new Set(series.flatMap(x=>x.points.map(p=>p.date.slice(0,10))))].sort();
  if(Number.isFinite(rows)&&rows>0)keys=keys.slice(-rows);
  keys.reverse();
  const maps=series.map(x=>Object.fromEntries(x.points.map(p=>[p.date.slice(0,10),p.value])));
  return `<table><thead><tr><th>Observation</th>${series.map(x=>`<th>${x.name}</th>`).join('')}</tr></thead><tbody>${keys.map(k=>`<tr><td>${dateLabel(k)}</td>${series.map((x,i)=>`<td>${maps[i][k]==null?'—':x.format(maps[i][k])}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
}
